<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MainWindowProgram'">
    <!-- Git HEAD и состояние рабочей копии не входят в стандартный граф входов MSBuild. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <Target Name="CollectBuildIdentity"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(MSBuildProjectName)' == 'MainWindowProgram'">
    <PropertyGroup>
      <BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString(&quot;yyyyMMdd.HHmmss&quot;))</BuildTimestampUtc>
      <BuildGitCommit>unknown</BuildGitCommit>
      <BuildGitCommitShort>unknown</BuildGitCommitShort>
      <BuildGitDirty>false</BuildGitDirty>
      <GitInstallPath>$([MSBuild]::GetRegistryValue('HKEY_LOCAL_MACHINE\SOFTWARE\GitForWindows', 'InstallPath'))</GitInstallPath>
      <GitExecutable Condition="Exists('$(GitInstallPath)\cmd\git.exe')">$(GitInstallPath)\cmd\git.exe</GitExecutable>
    </PropertyGroup>

    <Exec Command="where.exe git &gt;nul 2&gt;&amp;1"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="GitOnPathExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(GitExecutable)' == '' and '$(GitOnPathExitCode)' == '0'">
      <GitExecutable>git</GitExecutable>
    </PropertyGroup>

    <Exec Command="&quot;$(GitExecutable)&quot; rev-parse HEAD 2&gt;nul"
          Condition="'$(GitExecutable)' != ''"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildGitCommit" />
    </Exec>
    <Exec Command="&quot;$(GitExecutable)&quot; rev-parse --short=8 HEAD 2&gt;nul"
          Condition="'$(GitExecutable)' != ''"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildGitCommitShort" />
    </Exec>
    <Exec Command="&quot;$(GitExecutable)&quot; status --porcelain --untracked-files=normal 2&gt;nul"
          Condition="'$(GitExecutable)' != ''"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="BuildGitStatus" />
    </Exec>
    <Exec Command="&quot;$(GitExecutable)&quot; -c i18n.logOutputEncoding=cp866 log -20 --date=short --pretty=format:&quot;%25%25h,%25%25ad,%25%25s&quot; 2&gt;nul"
          Condition="'$(GitExecutable)' != ''"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="BuildGitHistory" />
    </Exec>

    <PropertyGroup Condition="'@(BuildGitStatus)' != ''">
      <BuildGitDirty>true</BuildGitDirty>
    </PropertyGroup>
    <PropertyGroup>
      <BuildIdentity>$(Version)+$(BuildTimestampUtc).$(BuildGitCommitShort)</BuildIdentity>
      <BuildIdentity Condition="'$(BuildGitDirty)' == 'true'">$(BuildIdentity)-dirty</BuildIdentity>
      <InformationalVersion>$(BuildIdentity)</InformationalVersion>
      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
      <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" />
      <AssemblyMetadata Include="GitCommit" Value="$(BuildGitCommit)" />
      <AssemblyMetadata Include="GitCommitShort" Value="$(BuildGitCommitShort)" />
      <AssemblyMetadata Include="GitDirty" Value="$(BuildGitDirty)" />
      <AssemblyMetadata Include="BuildIdentity" Value="$(BuildIdentity)" />
      <AssemblyMetadata Include="GitHistoryEntry" Value="%(BuildGitHistory.Identity)" />
    </ItemGroup>
  </Target>
</Project>
