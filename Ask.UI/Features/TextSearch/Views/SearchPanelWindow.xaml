<Window x:Class="Ask.UI.Features.TextSearch.Views.SearchPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Ask.UI.Shared.Components.Icons"
        xmlns:search="clr-namespace:Ask.UI.Features.TextSearch.Views"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Поиск" Width="500" Height="64" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" ShowInTaskbar="False" WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown" UseLayoutRounding="True" SnapsToDevicePixels="False" RenderOptions.EdgeMode="Unspecified">
  <Window.Resources>
    <!-- Semi.Avalonia MIT geometries; see Shared/Components/Icons/Semi.Avalonia.LICENSE.txt. -->
    <StreamGeometry x:Key="SearchGeometry">M16 10a6 6 0 1 1-12 0 6 6 0 0 1 12 0Zm-1.1 6.32a8 8 0 1 1 1.41-1.41l5.4 5.38a1 1 0 0 1-1.42 1.42l-5.38-5.39Z</StreamGeometry>
    <StreamGeometry x:Key="SemiIconArrowLeft">M23 12c0 .83-.67 1.5-1.5 1.5H6.12l6.44 6.44a1.5 1.5 0 0 1-2.12 2.12l-9-9a1.5 1.5 0 0 1 0-2.12l9-9a1.5 1.5 0 0 1 2.12 2.12L6.12 10.5H21.5c.83 0 1.5.67 1.5 1.5Z</StreamGeometry>
    <StreamGeometry x:Key="SemiIconArrowRight">M1 12c0-.83.67-1.5 1.5-1.5h15.38l-6.44-6.44a1.5 1.5 0 0 1 2.12-2.12l9 9a1.5 1.5 0 0 1 0 2.12l-9 9a1.5 1.5 0 0 1-2.12-2.12l6.44-6.44H2.5A1.5 1.5 0 0 1 1 12Z</StreamGeometry>
    <StreamGeometry x:Key="SemiIconChevronDown">M4.08 7.6a1.5 1.5 0 0 1 2.12 0l5.66 5.65 5.66-5.65a1.5 1.5 0 1 1 2.12 2.12l-6.72 6.72a1.5 1.5 0 0 1-2.12 0L4.08 9.72a1.5 1.5 0 0 1 0-2.12Z</StreamGeometry>
    <StreamGeometry x:Key="SemiIconChevronLeft">M16.28 4.24a1.5 1.5 0 0 1 0 2.12l-5.66 5.66 5.66 5.65a1.5 1.5 0 1 1-2.12 2.13l-6.72-6.72a1.5 1.5 0 0 1 0-2.12l6.72-6.72a1.5 1.5 0 0 1 2.12 0Z</StreamGeometry>
    <StreamGeometry x:Key="SemiIconChevronRight">M7.44 19.8a1.5 1.5 0 0 1 0-2.13l5.66-5.65-5.66-5.66a1.5 1.5 0 1 1 2.12-2.12l6.72 6.72a1.5 1.5 0 0 1 0 2.12L9.56 19.8a1.5 1.5 0 0 1-2.12 0Z</StreamGeometry>
    <!-- Curved outlines keep antialiasing; layout rounding still keeps text and control sizes stable. -->
    <SolidColorBrush x:Key="SearchPanelOutline" Color="#A6496171"/>
    <Style TargetType="Border">
      <Setter Property="SnapsToDevicePixels" Value="False"/>
      <Setter Property="RenderOptions.EdgeMode" Value="Unspecified"/>
    </Style>
    <ControlTemplate x:Key="RaisedSearchButtonTemplate" TargetType="primitives:ButtonBase">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.16"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.22"/>
                                        <VisualTransition To="Disabled" GeneratedDuration="0"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.025" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.025" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBevel"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RaisedShadows"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="InsetShading"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBevel"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RaisedShadows"
                                                             Storyboard.TargetProperty="Opacity" To="0.2" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="RaisedShadows" IsHitTestVisible="False">
                                <Border CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{Binding Foreground.Color, RelativeSource={RelativeSource TemplatedParent}}" Direction="135" BlurRadius="8"
                                                          ShadowDepth="2" Opacity="{DynamicResource TopPanelButtonHighlightOpacity}"/>
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="315" BlurRadius="8"
                                                          ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <Border x:Name="ButtonSurface" CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="ButtonBevel" CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Opacity="0.65" IsHitTestVisible="False"/>
                            <Grid x:Name="InsetShading" Opacity="0" IsHitTestVisible="False">
                                <Border CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#80000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.32"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.68"/>
                                            <GradientStop Color="#20FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#50000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.06"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.94"/>
                                            <GradientStop Color="#16FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
    <Style x:Key="RoundAction" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="Background" Value="{DynamicResource BackgroundBrushes}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TopPanelButtonBevelBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template" Value="{StaticResource RaisedSearchButtonTemplate}"/>
    </Style>
    <Style x:Key="ActionStroke" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
    <Style x:Key="SettingsAction" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="Background" Value="{DynamicResource BackgroundBrushes}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TopPanelButtonBevelBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/>
      <Setter Property="search:SearchPanelChrome.CornerRadius" Value="14"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template" Value="{StaticResource RaisedSearchButtonTemplate}"/>
    </Style>
    <Style x:Key="SearchOption" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="Background" Value="{DynamicResource BackgroundBrushes}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TopPanelButtonBevelBrush}"/>
      <Setter Property="search:SearchPanelChrome.CornerRadius" Value="15"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template" Value="{StaticResource RaisedSearchButtonTemplate}"/>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource VioletColorSolidColorBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource VioletColorSolidColorBrush}"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource VioletColorSolidColorBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <!-- Inset layers follow the password/role fields in RoleLoginWindow, with theme-neutral shading. -->
    <LinearGradientBrush x:Key="SearchInsetVertical" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#38000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.3"/>
      <GradientStop Color="#00FFFFFF" Offset="0.7"/><GradientStop Color="#12FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SearchInsetHorizontal" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#20000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.05"/>
      <GradientStop Color="#00FFFFFF" Offset="0.95"/><GradientStop Color="#0CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SearchRowSeparator" Color="#18496171"/>
    <Style x:Key="InsetField" TargetType="ContentControl">
      <Setter Property="Background" Value="{DynamicResource BackgroundBrushes}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
        <Grid>
          <Border CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}"/>
          <Border CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" Background="{StaticResource SearchInsetVertical}" IsHitTestVisible="False"/>
          <Border CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" Background="{StaticResource SearchInsetHorizontal}" IsHitTestVisible="False"/>
          <Border CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1" BorderBrush="{DynamicResource TopPanelButtonBevelBrush}" Opacity="0.55" IsHitTestVisible="False"/>
          <ContentPresenter Margin="{TemplateBinding Padding}"/>
          <Border x:Name="FieldFocus" CornerRadius="{Binding Path=(search:SearchPanelChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1" BorderBrush="{DynamicResource VioletColorSolidColorBrush}" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="FieldFocus" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="FieldFocus" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsInput" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="ResultHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource BackgroundBrushes}"/>
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,0"/><Setter Property="Height" Value="27"/>
      <Setter Property="BorderBrush" Value="{StaticResource SearchPanelOutline}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="DisplayIndex" Value="2"><Setter Property="BorderThickness" Value="0,0,0,1"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ResultCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="{StaticResource SearchPanelOutline}"/><Setter Property="Padding" Value="8,0"/>
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter VerticalAlignment="Center"/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LastResultCell" TargetType="DataGridCell" BasedOn="{StaticResource ResultCell}">
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="ResultRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow">
        <Grid Background="{TemplateBinding Background}">
          <Border x:Name="RowHighlight" Background="{DynamicResource VioletColorSolidColorBrush}" Opacity="0" IsHitTestVisible="False"/>
          <Border BorderBrush="{StaticResource SearchRowSeparator}" BorderThickness="0,0,0,1"><DataGridCellsPresenter/></Border>
          <Border x:Name="SelectionAccent" Width="2" Background="{DynamicResource VioletColorSolidColorBrush}" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowHighlight" Property="Opacity" Value="0.06"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowHighlight" Property="Opacity" Value="0.14"/><Setter TargetName="SelectionAccent" Property="Opacity" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <!-- Keep a native hit-test surface while the animated content fades out. -->
  <Grid Background="#01000000">
  <Grid x:Name="MotionRoot" Margin="8" RenderTransformOrigin="0.5,0">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="PanelScale"/>
    </Grid.RenderTransform>
    <Border CornerRadius="{Binding CornerRadius, ElementName=PanelShell}" Background="{DynamicResource BackgroundBrushes}" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
    </Border>
    <Border CornerRadius="{Binding CornerRadius, ElementName=PanelShell}" Background="{DynamicResource BackgroundBrushes}" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect Color="{DynamicResource ForegroundColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.12"/></Border.Effect>
    </Border>
    <Border x:Name="PanelShell" CornerRadius="24" BorderThickness="1"
            Background="{DynamicResource BackgroundBrushes}"
            BorderBrush="{DynamicResource TopPanelButtonBevelBrush}" Padding="10,0">
      <StackPanel>
      <Grid Height="46">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="52"/>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="39"/>
          <ColumnDefinition Width="36"/>
        </Grid.ColumnDefinitions>
        <ContentControl Style="{StaticResource InsetField}" search:SearchPanelChrome.CornerRadius="16" Height="32">
          <Grid Margin="10,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Path Data="{StaticResource SearchGeometry}" Fill="{DynamicResource ForegrounfBrushes}"
                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchInput" Grid.Column="1" FontSize="13" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource ForegrounfBrushes}"
                     CaretBrush="{DynamicResource ForegrounfBrushes}" VerticalContentAlignment="Center"
                     Padding="0" ToolTip="Текст для поиска" AutomationProperties.Name="Текст для поиска">
              <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                  <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                </ControlTemplate>
              </TextBox.Template>
            </TextBox>
            <TextBlock Grid.Column="1" Text="Поиск" FontSize="13" Opacity="0.5"
                       Foreground="{DynamicResource ForegrounfBrushes}" IsHitTestVisible="False" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </ContentControl>
        <TextBlock x:Name="SearchStatus" Grid.Column="1" Text="0 из 0" FontSize="11" Opacity="0.75"
                   Foreground="{DynamicResource ForegrounfBrushes}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" AutomationProperties.Name="Количество совпадений"/>
        <Button x:Name="PreviousButton" Click="Previous_Click" Grid.Column="2" Style="{StaticResource RoundAction}" ToolTip="Предыдущее совпадение" AutomationProperties.Name="Предыдущее совпадение">
          <Path Data="{StaticResource SemiIconArrowLeft}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
        </Button>
        <Button x:Name="NextButton" Click="Next_Click" Grid.Column="3" Style="{StaticResource RoundAction}" Foreground="{DynamicResource VioletColorSolidColorBrush}"
                ToolTip="Следующее совпадение" AutomationProperties.Name="Следующее совпадение">
          <Path Data="{StaticResource SemiIconArrowRight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
        </Button>
        <Border Grid.Column="4" Width="1" Height="32" Background="{StaticResource SearchPanelOutline}"/>
        <Button x:Name="FindAllButton" Click="FindAll_Click" Grid.Column="5" Style="{StaticResource RoundAction}" ToolTip="Найти все" AutomationProperties.Name="Найти все">
          <Viewbox Width="17" Height="18" Stretch="Uniform"><Grid Width="28" Height="30">
            <Path Style="{StaticResource ActionStroke}" StrokeThickness="2.8" Data="M 14,24 L 4,24 L 4,2 L 15,2 L 21,8 L 21,12 M 15,2 L 15,9 L 21,9"/>
            <Path Data="{StaticResource SearchGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="0.6" StrokeLineJoin="Round"
                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
          </Grid></Viewbox>
        </Button>
        <Button x:Name="SettingsButton" Click="Settings_Click" Grid.Column="6" Style="{StaticResource RoundAction}" ToolTip="Настройки поиска" AutomationProperties.Name="Настройки поиска">
          <icons:SettingsGearIcon Size="17" IsHovering="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <Button Grid.Column="7" Style="{StaticResource RoundAction}" ToolTip="Закрыть (Esc)" AutomationProperties.Name="Закрыть поиск" Click="Close_Click">
          <icons:WindowCloseIcon Size="18" IsHovering="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
      </Grid>
      <Border x:Name="SettingsPanel" Visibility="Collapsed" Margin="-3,0,-3,8" Padding="6"
              CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SearchPanelOutline}">
        <StackPanel>
          <Grid x:Name="ReplacementRow" Height="28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource InsetField}" search:SearchPanelChrome.CornerRadius="14" Margin="0,0,6,0" Padding="10,0">
              <Grid>
                <TextBox x:Name="ReplacementInput" Style="{StaticResource SettingsInput}" AutomationProperties.Name="Заменить на"/>
                <TextBlock Text="Заменить на..." IsHitTestVisible="False" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes}" Opacity="0.65">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=ReplacementInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </ContentControl>
            <Button x:Name="ReplaceButton" ToolTip="Заменить текущее совпадение указанным текстом" Click="Replace_Click" Grid.Column="1" Style="{StaticResource SettingsAction}" Content="Заменить" Margin="0,0,6,0"/>
            <Button x:Name="ReplaceAllButton" ToolTip="Заменить все совпадения в выбранной области поиска" Click="ReplaceAll_Click" Grid.Column="2" Style="{StaticResource SettingsAction}" Content="Заменить всё"/>
          </Grid>
          <Grid Height="30" Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
            <ToggleButton x:Name="MatchCaseOption" ToolTip="Различать прописные и строчные буквы при поиске" Style="{StaticResource SearchOption}" Content="Aa   Регистр" Margin="0,0,5,0" AutomationProperties.Name="Учитывать регистр"/>
            <ToggleButton x:Name="WholeWordOption" ToolTip="Искать только целые слова, исключая части слов" Grid.Column="1" Style="{StaticResource SearchOption}" Content="ab   Целое слово" Margin="0,0,5,0"/>
            <ToggleButton x:Name="RegexOption" ToolTip="Регулярные выражения .NET. В замене: $1, ${имя}, $$" Grid.Column="2" Style="{StaticResource SearchOption}" Content=".*   Регулярное выражение"/>
          </Grid>
          <Grid Height="28" Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Область поиска" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes}" Opacity="0.8" VerticalAlignment="Center"/>
            <ComboBox x:Name="SearchScope" Grid.Column="1" SelectedIndex="0" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes}" AutomationProperties.Name="Область поиска">
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                  <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
                  <Setter Property="Padding" Value="8,6"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsHighlighted" Value="True"><Setter Property="Foreground" Value="{DynamicResource VioletColorSolidColorBrush}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource VioletColorSolidColorBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate></Setter.Value></Setter>
                </Style>
              </ComboBox.ItemContainerStyle>
              <ComboBox.Template><ControlTemplate TargetType="ComboBox">
                <Grid>
                  <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                      <ContentControl Style="{StaticResource InsetField}" search:SearchPanelChrome.CornerRadius="14">
                        <Path Data="{StaticResource SemiIconChevronDown}" Fill="{DynamicResource ForegrounfBrushes}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                      </ContentControl>
                    </ControlTemplate></ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <Border x:Name="ScopeFocus" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource VioletColorSolidColorBrush}" Opacity="0" IsHitTestVisible="False"/>
                  <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                    <Border Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource SearchPanelOutline}" Background="{DynamicResource SettingCardBackground}">
                      <ScrollViewer MaxHeight="180"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                    </Border>
                  </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ScopeFocus" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ScopeFocus" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></ComboBox.Template>
              <ComboBoxItem Content="Все открытые документы"/>
              <ComboBoxItem Content="Текущий документ"/>
            </ComboBox>
          </Grid>
          <Grid Height="24" Margin="0,5,0,0">
            <CheckBox x:Name="SelectionOnlyOption" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Выделите текст перед открытием поиска" Content="Искать в выделении" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes}" VerticalAlignment="Center">
              <CheckBox.Template><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource SearchPanelOutline}" Background="{DynamicResource SettingCardBackground}">
                    <Path x:Name="Check" Visibility="Collapsed" Data="M 2,6 L 5,9 L 11,2" Stroke="{DynamicResource VioletColorSolidColorBrush}" StrokeThickness="1.5" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Border>
                  <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource VioletColorSolidColorBrush}"/></Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource VioletColorSolidColorBrush}"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource VioletColorSolidColorBrush}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></CheckBox.Template>
            </CheckBox>
            <Button x:Name="ResetSettingsButton" ToolTip="Очистить текст замены и вернуть исходные параметры поиска" search:SearchPanelChrome.CornerRadius="12" Content="Сбросить" Click="ResetSettings_Click" Style="{StaticResource SettingsAction}" HorizontalAlignment="Right" Width="74"/>
          </Grid>
        </StackPanel>
      </Border>
      <Border x:Name="ResultsPanel" Visibility="Collapsed" Margin="-3,0,-3,8" Padding="6" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SearchPanelOutline}">
        <StackPanel>
          <Grid Height="30">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
            <TextBlock Text="Результаты поиска" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ForegrounfBrushes}" VerticalAlignment="Center"/>
            <TextBlock x:Name="ResultsSummary" Grid.Column="1" Margin="10,0,4,0" FontSize="10" Opacity="0.75" Foreground="{DynamicResource ForegrounfBrushes}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <icons:ArrowButton x:Name="CollapseResultsButton" Grid.Column="2" Width="26" Height="26"
                               ButtonBackground="Transparent" ButtonBorder="Transparent"
                               ArrowBrush="{DynamicResource ForegrounfBrushes}" ArrowHoverBrush="{DynamicResource VioletColorSolidColorBrush}"
                               IsArrowUp="True" ToggleOnClick="False" Click="CollapseResults_Click"
                               ToolTip="Свернуть результаты" AutomationProperties.Name="Свернуть результаты"/>
          </Grid>
          <StackPanel x:Name="ResultsBody">
            <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource TopPanelButtonBevelBrush}" Background="{DynamicResource BackgroundBrushes}" ClipToBounds="True">
              <Grid x:Name="ResultsViewport" Height="157" SizeChanged="ResultsViewport_SizeChanged">
                <DataGrid x:Name="ResultsGrid" SizeChanged="ResultsGrid_SizeChanged" Style="{x:Null}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserResizeColumns="False" RowHeight="26"
                          HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None" VerticalGridLinesBrush="{StaticResource SearchPanelOutline}"
                          Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True" Foreground="{DynamicResource ForegrounfBrushes}" FontSize="11"
                          SelectionMode="Single" SelectionUnit="FullRow" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ColumnHeaderStyle="{StaticResource ResultHeader}" CellStyle="{StaticResource ResultCell}" RowStyle="{StaticResource ResultRow}" SelectionChanged="ResultsGrid_SelectionChanged">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Имя файла" Width="136"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Строка" Width="54"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <TextBlock Text="{Binding LineNumber}" Opacity="0.6"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Текст строки" Width="240" CellStyle="{StaticResource LastResultCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding LineText}"><Run Text="{Binding Before, Mode=OneWay}"/><Run Text="{Binding Hit, Mode=OneWay}" Foreground="{DynamicResource VioletColorSolidColorBrush}" FontWeight="SemiBold"/><Run Text="{Binding After, Mode=OneWay}"/></TextBlock>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyResults" Text="Совпадений не найдено" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes}" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <Grid Height="35" Margin="0,4,0,0">
              <TextBlock x:Name="ResultsRange" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes}" Opacity="0.75" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="PreviousResultsPage" Style="{StaticResource RoundAction}" Width="26" Height="26" Click="PreviousResultsPage_Click" ToolTip="Предыдущая страница">
                  <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource SemiIconChevronLeft}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
                </Button>
                <StackPanel x:Name="ResultsPages" Orientation="Horizontal"/>
                <Button x:Name="NextResultsPage" Style="{StaticResource RoundAction}" Width="26" Height="26" Click="NextResultsPage_Click" ToolTip="Следующая страница">
                  <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource SemiIconChevronRight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
