<Window x:Class="Ask.UI.Features.TextSearch.Views.SearchPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск" Width="500" Height="64" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" ShowInTaskbar="False" WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Unspecified">
  <Window.Resources>
    <!-- Semi.Avalonia MIT geometries; see Shared/Components/Icons/Semi.Avalonia.LICENSE.txt. -->
    <StreamGeometry x:Key="SearchGeometry">M16 10a6 6 0 1 1-12 0 6 6 0 0 1 12 0Zm-1.1 6.32a8 8 0 1 1 1.41-1.41l5.4 5.38a1 1 0 0 1-1.42 1.42l-5.38-5.39Z</StreamGeometry>
    <StreamGeometry x:Key="SettingsGeometry">M10.59 1.38c-.83 0-1.5.67-1.5 1.5v1.63L6.98 5.73l-1.4-.8a1.5 1.5 0 0 0-2.04.54L2.1 7.94A1.5 1.5 0 0 0 2.66 10l1.4.8v2.43l-1.42.82a1.5 1.5 0 0 0-.55 2.05l1.43 2.46a1.5 1.5 0 0 0 2.05.55l1.42-.82 2.1 1.2v1.64c0 .83.67 1.5 1.5 1.5h2.84c.83 0 1.5-.67 1.5-1.5v-1.64l2.08-1.2 1.45.83a1.5 1.5 0 0 0 2.04-.55l1.43-2.47a1.5 1.5 0 0 0-.55-2.05l-1.44-.83v-2.4l1.42-.83a1.5 1.5 0 0 0 .55-2.04l-1.42-2.47a1.5 1.5 0 0 0-2.05-.55l-1.41.81-2.1-1.2V2.87c0-.83-.67-1.5-1.5-1.5H10.6Zm.5 3.42V3.38h1.84v1.43c0 .54.29 1.03.75 1.3l2.6 1.5a1.5 1.5 0 0 0 1.5 0L19 6.9l.93 1.6-1.24.7a1.5 1.5 0 0 0-.75 1.3v3c0 .53.29 1.02.75 1.3l1.26.72-.93 1.6-1.26-.73a1.5 1.5 0 0 0-1.5 0l-2.58 1.49a1.5 1.5 0 0 0-.75 1.3v1.43H11.1V19.2a1.5 1.5 0 0 0-.75-1.3l-2.6-1.5a1.5 1.5 0 0 0-1.5 0L5 17.12l-.93-1.6 1.24-.71c.46-.27.75-.76.75-1.3v-3a1.5 1.5 0 0 0-.75-1.3l-1.22-.7.93-1.6 1.2.7a1.5 1.5 0 0 0 1.5 0l2.62-1.51c.46-.27.75-.76.75-1.3ZM12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm1.5-3.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z</StreamGeometry>
    <SolidColorBrush x:Key="SearchPanelOutline" Color="#496171"/>
    <Style x:Key="RoundAction" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="Background" Value="{DynamicResource SettingCardBackground}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SearchPanelOutline}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="16" BorderThickness="1"
                    BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SearchAccentBrush}"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SearchAccentBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SearchAccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionStroke" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
    <Style x:Key="SettingsAction" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="Background" Value="{DynamicResource SettingCardBackground}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SearchPanelOutline}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" CornerRadius="14" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SearchAccentBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SearchAccentBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="SearchOption" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="Background" Value="{DynamicResource SettingCardBackground}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Surface" CornerRadius="15" BorderThickness="1" BorderBrush="{StaticResource SearchPanelOutline}" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource SearchAccentBrush}"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SearchAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SearchAccentBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SearchAccentBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsInput" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource ForegrounfBrushes}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="8">
    <Border x:Name="PanelShell" CornerRadius="24" BorderThickness="1"
            Background="{DynamicResource SearchPanelBackgroundBrush}"
            BorderBrush="{StaticResource SearchPanelOutline}" Padding="10,0">
      <StackPanel>
      <Grid Height="46">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="52"/>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="39"/>
          <ColumnDefinition Width="36"/>
        </Grid.ColumnDefinitions>
        <Border Height="32" CornerRadius="16" BorderThickness="1"
                Background="{DynamicResource SettingCardBackground}" BorderBrush="{StaticResource SearchPanelOutline}">
          <Grid Margin="10,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Path Data="{StaticResource SearchGeometry}" Fill="{DynamicResource ForegrounfBrushes}"
                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchInput" Grid.Column="1" FontSize="13" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource ForegrounfBrushes}"
                     CaretBrush="{DynamicResource ForegrounfBrushes}" VerticalContentAlignment="Center"
                     Padding="0" ToolTip="Текст для поиска" AutomationProperties.Name="Текст для поиска">
              <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                  <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                </ControlTemplate>
              </TextBox.Template>
            </TextBox>
            <TextBlock Grid.Column="1" Text="Поиск" FontSize="13" Opacity="0.5"
                       Foreground="{DynamicResource ForegrounfBrushes}" IsHitTestVisible="False" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
        <TextBlock x:Name="SearchStatus" Grid.Column="1" Text="0 из 0" FontSize="11" Opacity="0.75"
                   Foreground="{DynamicResource ForegrounfBrushes}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" AutomationProperties.Name="Количество совпадений"/>
        <Button x:Name="PreviousButton" Click="Previous_Click" Grid.Column="2" Style="{StaticResource RoundAction}" ToolTip="Предыдущее совпадение" AutomationProperties.Name="Предыдущее совпадение">
          <Path Style="{StaticResource ActionStroke}" Data="M 20,12 L 2,12 M 9,5 L 2,12 L 9,19" Width="14" Height="14" Stretch="Uniform"/>
        </Button>
        <Button x:Name="NextButton" Click="Next_Click" Grid.Column="3" Style="{StaticResource RoundAction}" Foreground="{DynamicResource SearchAccentBrush}"
                ToolTip="Следующее совпадение" AutomationProperties.Name="Следующее совпадение">
          <Path Style="{StaticResource ActionStroke}" Data="M 2,12 L 20,12 M 13,5 L 20,12 L 13,19" Width="14" Height="14" Stretch="Uniform"/>
        </Button>
        <Border Grid.Column="4" Width="1" Height="32" Background="{StaticResource SearchPanelOutline}"/>
        <Button Grid.Column="5" Style="{StaticResource RoundAction}" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Найти все — пока не подключено" AutomationProperties.Name="Найти все">
          <Viewbox Width="17" Height="18" Stretch="Uniform"><Grid Width="28" Height="30">
            <Path Style="{StaticResource ActionStroke}" Data="M 14,24 L 4,24 L 4,2 L 15,2 L 21,8 L 21,12 M 15,2 L 15,9 L 21,9"/>
            <Path Data="{StaticResource SearchGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
          </Grid></Viewbox>
        </Button>
        <Button x:Name="SettingsButton" Click="Settings_Click" Grid.Column="6" Style="{StaticResource RoundAction}" ToolTip="Настройки поиска" AutomationProperties.Name="Настройки поиска">
          <Path Data="{StaticResource SettingsGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Width="17" Height="17" Stretch="Uniform"/>
        </Button>
        <Button Grid.Column="7" Style="{StaticResource RoundAction}" ToolTip="Закрыть (Esc)" AutomationProperties.Name="Закрыть поиск" Click="Close_Click">
          <Path Style="{StaticResource ActionStroke}" Data="M 4,4 L 20,20 M 20,4 L 4,20" Width="14" Height="14" Stretch="Uniform"/>
        </Button>
      </Grid>
      <Border x:Name="SettingsPanel" Visibility="Collapsed" Margin="-3,0,-3,8" Padding="6"
              CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource SearchPanelOutline}">
        <StackPanel>
          <Grid x:Name="ReplacementRow" Height="28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
            <Border CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource SearchPanelOutline}" Background="{DynamicResource SettingCardBackground}" Margin="0,0,6,0" Padding="9,0">
              <Grid>
                <TextBox x:Name="ReplacementInput" Style="{StaticResource SettingsInput}" AutomationProperties.Name="Заменить на"/>
                <TextBlock Text="Заменить на..." IsHitTestVisible="False" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes}" Opacity="0.65">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=ReplacementInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
            <Button x:Name="ReplaceButton" Click="Replace_Click" Grid.Column="1" Style="{StaticResource SettingsAction}" Content="Заменить" Margin="0,0,6,0"/>
            <Button x:Name="ReplaceAllButton" Click="ReplaceAll_Click" Grid.Column="2" Style="{StaticResource SettingsAction}" Content="Заменить всё"/>
          </Grid>
          <Grid Height="30" Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
            <ToggleButton x:Name="MatchCaseOption" Style="{StaticResource SearchOption}" Content="Aa   Регистр" Margin="0,0,5,0" AutomationProperties.Name="Учитывать регистр"/>
            <ToggleButton x:Name="WholeWordOption" Grid.Column="1" Style="{StaticResource SearchOption}" Content="ab   Целое слово" Margin="0,0,5,0"/>
            <ToggleButton x:Name="RegexOption" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Регулярные выражения не поддерживаются прежним поиском" Grid.Column="2" Style="{StaticResource SearchOption}" Content=".*   Регулярное выражение"/>
          </Grid>
          <Grid Height="28" Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Область поиска" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes}" Opacity="0.8" VerticalAlignment="Center"/>
            <ComboBox x:Name="SearchScope" Grid.Column="1" SelectedIndex="0" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes}" AutomationProperties.Name="Область поиска">
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                  <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
                  <Setter Property="Padding" Value="8,6"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsHighlighted" Value="True"><Setter Property="Foreground" Value="{DynamicResource SearchAccentBrush}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource SearchAccentBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate></Setter.Value></Setter>
                </Style>
              </ComboBox.ItemContainerStyle>
              <ComboBox.Template><ControlTemplate TargetType="ComboBox">
                <Grid>
                  <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                      <Border CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource SearchPanelOutline}" Background="{DynamicResource SettingCardBackground}">
                        <Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource ForegrounfBrushes}" StrokeThickness="1.5" Width="10" Height="5" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                      </Border>
                    </ControlTemplate></ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                    <Border Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource SearchPanelOutline}" Background="{DynamicResource SettingCardBackground}">
                      <ScrollViewer MaxHeight="180"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                    </Border>
                  </Popup>
                </Grid>
              </ControlTemplate></ComboBox.Template>
              <ComboBoxItem Content="Все открытые документы"/>
              <ComboBoxItem Content="Текущий документ"/>
            </ComboBox>
          </Grid>
          <Grid Height="24" Margin="0,5,0,0">
            <CheckBox x:Name="SelectionOnlyOption" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Поиск в выделении не поддерживается прежним поиском" Content="Искать в выделении" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes}" VerticalAlignment="Center" Opacity="0.4">
              <CheckBox.Template><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource SearchPanelOutline}" Background="{DynamicResource SettingCardBackground}">
                    <Path x:Name="Check" Visibility="Collapsed" Data="M 2,6 L 5,9 L 11,2" Stroke="{DynamicResource SearchAccentBrush}" StrokeThickness="1.5" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Border>
                  <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SearchAccentBrush}"/></Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SearchAccentBrush}"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SearchAccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></CheckBox.Template>
            </CheckBox>
            <Button x:Name="ResetSettingsButton" Content="Сбросить" Click="ResetSettings_Click" Style="{StaticResource SettingsAction}" HorizontalAlignment="Right" Width="74"/>
          </Grid>
        </StackPanel>
      </Border>
      </StackPanel>
    </Border>
  </Grid>
</Window>
