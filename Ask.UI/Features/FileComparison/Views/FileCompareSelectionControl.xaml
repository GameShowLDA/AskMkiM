<UserControl x:Class="Ask.UI.Features.FileComparison.Views.FileCompareSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:Ask.UI.Shared.Components.Icons"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="DiffListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CompareCardBorderStyle" TargetType="Border" BasedOn="{StaticResource SettingCardStyle}">
                <Setter Property="Padding" Value="12"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"/>
            </Style>

            <Style x:Key="CompareCardTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MainTitleSolidColorBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource WinstonBold}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="CompareItemTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource WinstonRegular}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
            </Style>

            <Style x:Key="ComparePathTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CompareItemTextStyle}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Opacity" Value="0.75"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="CompareBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource WinstonRegular}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="CompareStatisticCardStyle" TargetType="Border">
                <Setter Property="Width" Value="76"/>
                <Setter Property="Height" Value="72"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
            </Style>

            <Style x:Key="CompareStatisticValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource WinstonBold}"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource MainTitleSolidColorBrush}"/>
            </Style>

            <Style x:Key="CompareStatisticLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource WinstonRegular}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes85}"/>
            </Style>

            <Style x:Key="CompareRefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource TopMenuLikeIconButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SettingCardBackground}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="DiffLineTemplate">
                <Border Background="{Binding BackgroundBrush}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="0"
                        Padding="6,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Prefix}"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{Binding ForegroundBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LineNumberText}"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   Opacity="0.75"
                                   TextAlignment="Right"
                                   Foreground="{Binding ForegroundBrush}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Text}"
                                   Margin="10,0,0,0"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   TextWrapping="NoWrap"
                                   Foreground="{Binding ForegroundBrush}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Padding="16"
                Background="{DynamicResource SettingCardBackground}"
                BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" Margin="0,0,18,0" CornerRadius="10"
                            Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}">
                        <icons:FileDocumentIcon Size="34" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Foreground="{DynamicResource MainTitleSolidColorBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Сравнение файлов" FontSize="24"
                                   FontFamily="{DynamicResource WinstonBold}"
                                   Foreground="{DynamicResource MainTitleSolidColorBrush}"/>
                        <TextBlock Text="Выберите исходный файл и один или несколько открытых файлов справа. После запуска каждый правый файл будет показан отдельной вкладкой."
                                   Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource ForegrounfBrushes85}"
                                   FontFamily="{DynamicResource WinstonRegular}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,18,0" ToolTip="{Binding ComparisonSummary}">
                    <Border Style="{StaticResource CompareStatisticCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ComparedFilesCount}" Style="{StaticResource CompareStatisticValueStyle}"/>
                            <TextBlock Text="Файлов" Style="{StaticResource CompareStatisticLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompareStatisticCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AddedLinesCount}" Style="{StaticResource CompareStatisticValueStyle}"
                                       Foreground="{DynamicResource NotificationSuccessIconBrush}"/>
                            <TextBlock Text="Добавлено" Style="{StaticResource CompareStatisticLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompareStatisticCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding RemovedLinesCount}" Style="{StaticResource CompareStatisticValueStyle}"
                                       Foreground="{DynamicResource NotificationErrorIconBrush}"/>
                            <TextBlock Text="Удалено" Style="{StaticResource CompareStatisticLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompareStatisticCardStyle}" Margin="0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModifiedLinesCount}" Style="{StaticResource CompareStatisticValueStyle}"
                                       Foreground="{DynamicResource NotificationWarningIconBrush}"/>
                            <TextBlock Text="Изменено" Style="{StaticResource CompareStatisticLabelStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Height="46" Padding="16,10" FontFamily="{DynamicResource WinstonBold}" FontSize="14"
                            Style="{StaticResource CompareRefreshButtonStyle}"
                            IsEnabled="{Binding CanRefresh}" Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Margin="0,0,10,0" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 17,7 A 7,7 0 1 0 17,13 M 17,2 L 17,7 L 12,7"/>
                            <TextBlock Text="Обновить список" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Height="46" Padding="16,10" Margin="12,0,0,0"
                            IsEnabled="{Binding CanStartCompare}" FontFamily="{DynamicResource WinstonBold}" FontSize="14"
                            Style="{DynamicResource SaveButtonStyle}" Click="StartCompareButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="14" Margin="0,0,10,0" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 0,0 L 0,14 L 12,7 Z"/>
                            <TextBlock Text="Запустить сравнение" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding SelectionPanelVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,12"
                    Style="{StaticResource CompareCardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Исходный файл"
                               Margin="0,0,0,8"
                               Style="{StaticResource CompareCardTitleStyle}"
                               Foreground="{DynamicResource MainTitleSolidColorBrush}" />
                    <ComboBox ItemsSource="{Binding OpenFiles}"
                              SelectedItem="{Binding SelectedSourceFile, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding HasEnoughFiles}"
                              Style="{DynamicResource CustomComboBoxStyle}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CompareCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Файлы для сравнения"
                                   Margin="0,0,0,8"
                                   Style="{StaticResource CompareCardTitleStyle}"/>

                        <ListBox ItemsSource="{Binding TargetFiles}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource DiffListBoxItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,4"
                                              Style="{DynamicResource SettingsCheckBox2}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding File.DisplayName}"
                                                       Style="{StaticResource CompareItemTextStyle}" />
                                            <TextBlock Text="{Binding File.FilePath}"
                                                       Style="{StaticResource ComparePathTextStyle}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CompareCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Текущий список"
                                   Margin="0,0,0,8"
                                   Style="{StaticResource CompareCardTitleStyle}"/>
                        <TextBlock Margin="0,0,0,8"
                                   Text="{Binding SelectionSummary}"
                                   Style="{StaticResource CompareBodyTextStyle}" />
                        <ListBox ItemsSource="{Binding SelectedTargetFiles}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource DiffListBoxItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource CompareItemTextStyle}" />
                                        <TextBlock Text="{Binding FilePath}"
                                                   Style="{StaticResource ComparePathTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Visibility="{Binding ResultsPanelVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CompareCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{Binding ActiveComparison.SourceTitle}"
                                   Padding="12,8"
                                   FontFamily="{DynamicResource WinstonBold}"
                                   FontSize="16"
                                   Foreground="{DynamicResource MainTitleSolidColorBrush}" />
                        <ListBox x:Name="SourceLinesListBox"
                                 Grid.Row="1"
                                 ItemsSource="{Binding ActiveComparison.SourceLines}"
                                 ItemTemplate="{StaticResource DiffLineTemplate}"
                                 ItemContainerStyle="{StaticResource DiffListBoxItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.ScrollChanged="SourceLinesListBox_ScrollChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CompareCardBorderStyle}">
                    <TabControl x:Name="ComparisonTabControl"
                                ItemsSource="{Binding ComparisonResults}"
                                TabStripPlacement="Bottom"
                                SelectedItem="{Binding ActiveComparison, Mode=TwoWay}"
                                Background="Transparent">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TargetTitle}" FontFamily="{DynamicResource WinstonRegular}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding TargetHeader}"
                                               Padding="12,8"
                                               FontFamily="{DynamicResource WinstonBold}"
                                               FontSize="16"
                                               Foreground="{DynamicResource MainTitleSolidColorBrush}" />
                                    <ListBox x:Name="TargetLinesListBox"
                                             Grid.Row="1"
                                             ItemsSource="{Binding TargetLines}"
                                             ItemTemplate="{StaticResource DiffLineTemplate}"
                                             ItemContainerStyle="{StaticResource DiffListBoxItemStyle}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.ScrollChanged="TargetLinesListBox_ScrollChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </Grid>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="14,10"
                MinHeight="48"
                CornerRadius="8"
                Background="{DynamicResource SettingCardBackground}"
                BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="26" Height="26" Margin="0,0,16,0"
                      Visibility="{Binding ResultsPanelVisibility}">
                    <Ellipse Fill="{DynamicResource NotificationSuccessIconBrush}"/>
                    <Path Data="M 7,13 L 11,17 L 19,9"
                          Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Grid>
                <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"
                           FontFamily="{DynamicResource WinstonMedium}" FontSize="13"
                           Foreground="{DynamicResource ForegrounfBrushes85}"/>
                <Border Width="1" Height="20" Margin="20,0"
                        Background="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                        Visibility="{Binding ResultsPanelVisibility}"/>
                <TextBlock VerticalAlignment="Center"
                           Visibility="{Binding ResultsPanelVisibility}"
                           FontFamily="{DynamicResource WinstonRegular}" FontSize="13"
                           Foreground="{DynamicResource ForegrounfBrushes85}">
                    <Run Text="Файлов справа: "/><Run Text="{Binding ComparedFilesCount, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

