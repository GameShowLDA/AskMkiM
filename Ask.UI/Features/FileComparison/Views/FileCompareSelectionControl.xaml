<UserControl x:Class="Ask.UI.Features.FileComparison.Views.FileCompareSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:Ask.UI.Shared.Components.Icons"
             xmlns:local="clr-namespace:Ask.UI.Features.FileComparison.Views"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="DiffListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CompareCardBorderStyle" TargetType="Border" BasedOn="{StaticResource SettingCardStyle}">
                <Setter Property="Padding" Value="12"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"/>
            </Style>

            <Style x:Key="CompareCardTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MainTitleSolidColorBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource WinstonBold}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="CompareItemTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource WinstonRegular}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
            </Style>

            <Style x:Key="ComparePathTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CompareItemTextStyle}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Opacity" Value="0.75"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="CompareBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource WinstonRegular}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="CompareStatisticCardStyle" TargetType="Border">
                <Setter Property="Width" Value="76"/>
                <Setter Property="Height" Value="72"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
            </Style>

            <Style x:Key="CompareStatisticValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource WinstonBold}"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource MainTitleSolidColorBrush}"/>
            </Style>

            <Style x:Key="CompareStatisticLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource WinstonRegular}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes85}"/>
            </Style>

            <Style x:Key="CompareRefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource TopMenuLikeIconButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SettingCardBackground}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CompareResultPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SettingCardBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>

            <Style x:Key="ComparePaneHeaderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="9,9,0,0"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style x:Key="ComparePaneTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource WinstonBold}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{DynamicResource MainTitleSolidColorBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="ComparePanePathStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource WinstonRegular}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes85}"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="CompareScrollThumbStyle" TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackgroundBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="1"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBackgroundBrush}"/>
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbPressedBackgroundBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CompareScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton x:Name="DecreasePage" Command="ScrollBar.PageUpCommand"
                                                      Focusable="False" IsTabStop="False" Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource CompareScrollThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton x:Name="IncreasePage" Command="ScrollBar.PageDownCommand"
                                                      Focusable="False" IsTabStop="False" Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                    <Setter TargetName="DecreasePage" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                    <Setter TargetName="IncreasePage" Property="Command" Value="ScrollBar.PageRightCommand"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="8"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CompareDiffListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource DiffListBoxItemStyle}">
                <Setter Property="MinHeight" Value="{Binding DiffRowHeight, RelativeSource={RelativeSource AncestorType={x:Type local:FileCompareSelectionControl}}}"/>
            </Style>

            <Style x:Key="CompareLinesListStyle" TargetType="ListBox">
                <Style.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource CompareScrollBarStyle}"/>
                </Style.Resources>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ItemTemplate" Value="{DynamicResource DiffRowPairTemplate}"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource CompareDiffListBoxItemStyle}"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <EventSetter Event="PreviewMouseWheel" Handler="DiffLines_PreviewMouseWheel"/>
            </Style>

            <Style x:Key="CompareTargetTabStyle" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MainTitleSolidColorBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CompareDiffRowStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="{Binding DiffRowHeight, RelativeSource={RelativeSource AncestorType={x:Type local:FileCompareSelectionControl}}}"/>
                <Setter Property="Background" Value="{Binding BackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{Binding ForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Unchanged">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Empty">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CompareDiffTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="{Binding DiffFontSize, RelativeSource={RelativeSource AncestorType={x:Type local:FileCompareSelectionControl}}}"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="LineHeight" Value="{Binding DiffRowHeight, RelativeSource={RelativeSource AncestorType={x:Type local:FileCompareSelectionControl}}}"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                <Setter Property="Foreground" Value="{Binding ForegroundBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Unchanged">
                        <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Empty">
                        <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes45}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="DiffLineTemplate">
                <Border Style="{StaticResource CompareDiffRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding DiffMarkerColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type local:FileCompareSelectionControl}}}"/>
                            <ColumnDefinition Width="{Binding DiffLineNumberColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type local:FileCompareSelectionControl}}}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2"
                                BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                BorderThickness="0,0,1,0"/>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Prefix}"
                                   Style="{StaticResource CompareDiffTextStyle}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LineNumberText}"
                                   Style="{StaticResource CompareDiffTextStyle}"
                                   FontSize="{Binding DiffLineNumberFontSize, RelativeSource={RelativeSource AncestorType={x:Type local:FileCompareSelectionControl}}}"
                                   Opacity="0.75"
                                   Margin="0,0,12,0"
                                   TextAlignment="Right"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Text}"
                                   Margin="10,0,4,0"
                                   Style="{StaticResource CompareDiffTextStyle}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="DiffRowPairTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding Source}" Margin="9,0"
                                      ContentTemplate="{StaticResource DiffLineTemplate}"/>
                    <ContentPresenter Grid.Column="2" Content="{Binding Target}" Margin="9,0"
                                      ContentTemplate="{StaticResource DiffLineTemplate}"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Padding="16"
                Background="{DynamicResource SettingCardBackground}"
                BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" Margin="0,0,18,0" CornerRadius="10"
                            Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}">
                        <icons:FileDocumentIcon Size="34" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Foreground="{DynamicResource MainTitleSolidColorBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Сравнение файлов" FontSize="24"
                                   FontFamily="{DynamicResource WinstonBold}"
                                   Foreground="{DynamicResource MainTitleSolidColorBrush}"/>
                        <TextBlock Text="Выберите исходный файл и один или несколько открытых файлов справа. После запуска каждый правый файл будет показан отдельной вкладкой."
                                   Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource ForegrounfBrushes85}"
                                   FontFamily="{DynamicResource WinstonRegular}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,18,0" ToolTip="{Binding ComparisonSummary}">
                    <Border Style="{StaticResource CompareStatisticCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ComparedFilesCount}" Style="{StaticResource CompareStatisticValueStyle}"/>
                            <TextBlock Text="Файлов" Style="{StaticResource CompareStatisticLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompareStatisticCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AddedLinesCount}" Style="{StaticResource CompareStatisticValueStyle}"
                                       Foreground="{DynamicResource NotificationSuccessIconBrush}"/>
                            <TextBlock Text="Добавлено" Style="{StaticResource CompareStatisticLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompareStatisticCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding RemovedLinesCount}" Style="{StaticResource CompareStatisticValueStyle}"
                                       Foreground="{DynamicResource NotificationErrorIconBrush}"/>
                            <TextBlock Text="Удалено" Style="{StaticResource CompareStatisticLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompareStatisticCardStyle}" Margin="0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModifiedLinesCount}" Style="{StaticResource CompareStatisticValueStyle}"
                                       Foreground="{DynamicResource NotificationWarningIconBrush}"/>
                            <TextBlock Text="Изменено" Style="{StaticResource CompareStatisticLabelStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Height="46" Padding="16,10" FontFamily="{DynamicResource WinstonBold}" FontSize="14"
                            Style="{StaticResource CompareRefreshButtonStyle}"
                            IsEnabled="{Binding CanRefresh}" Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Margin="0,0,10,0" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 17,7 A 7,7 0 1 0 17,13 M 17,2 L 17,7 L 12,7"/>
                            <TextBlock Text="Обновить список" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Height="46" Padding="16,10" Margin="12,0,0,0"
                            IsEnabled="{Binding CanStartCompare}" FontFamily="{DynamicResource WinstonBold}" FontSize="14"
                            Style="{DynamicResource SaveButtonStyle}" Click="StartCompareButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="14" Margin="0,0,10,0" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 0,0 L 0,14 L 12,7 Z"/>
                            <TextBlock Text="Запустить сравнение" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding SelectionPanelVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,12"
                    Style="{StaticResource CompareCardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Исходный файл"
                               Margin="0,0,0,8"
                               Style="{StaticResource CompareCardTitleStyle}"
                               Foreground="{DynamicResource MainTitleSolidColorBrush}" />
                    <ComboBox ItemsSource="{Binding OpenFiles}"
                              SelectedItem="{Binding SelectedSourceFile, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding HasEnoughFiles}"
                              Style="{DynamicResource CustomComboBoxStyle}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CompareCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Файлы для сравнения"
                                   Margin="0,0,0,8"
                                   Style="{StaticResource CompareCardTitleStyle}"/>

                        <ListBox ItemsSource="{Binding TargetFiles}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource DiffListBoxItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,4"
                                              Style="{DynamicResource SettingsCheckBox2}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding File.DisplayName}"
                                                       Style="{StaticResource CompareItemTextStyle}" />
                                            <TextBlock Text="{Binding File.FilePath}"
                                                       Style="{StaticResource ComparePathTextStyle}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CompareCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Текущий список"
                                   Margin="0,0,0,8"
                                   Style="{StaticResource CompareCardTitleStyle}"/>
                        <TextBlock Margin="0,0,0,8"
                                   Text="{Binding SelectionSummary}"
                                   Style="{StaticResource CompareBodyTextStyle}" />
                        <ListBox ItemsSource="{Binding SelectedTargetFiles}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource DiffListBoxItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource CompareItemTextStyle}" />
                                        <TextBlock Text="{Binding FilePath}"
                                                   Style="{StaticResource ComparePathTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Visibility="{Binding ResultsPanelVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource CompareResultPanelStyle}"/>
                <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource CompareResultPanelStyle}"/>
                <Border Grid.Column="0" Margin="1" Style="{StaticResource ComparePaneHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="8" Margin="0,0,14,0"
                                Background="{DynamicResource SettingCardBackground}">
                            <icons:FileDocumentIcon Size="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource NotificationInfoIconBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveComparison.SourceTitle}"
                                       ToolTip="{Binding ActiveComparison.SourceTitle}"
                                       Style="{StaticResource ComparePaneTitleStyle}"/>
                            <TextBlock Text="{Binding ActiveComparison.SourceFile.FilePath}"
                                       ToolTip="{Binding ActiveComparison.SourceFile.FilePath}"
                                       Style="{StaticResource ComparePanePathStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Grid.Column="0" Margin="9,0,9,8" ClipToBounds="True" IsHitTestVisible="False">
                    <Border Width="{Binding DiffGutterWidth}" HorizontalAlignment="Left"
                            Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
                </Grid>

                <Border Grid.Column="2" Margin="1" Style="{StaticResource ComparePaneHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="8" Margin="0,0,14,0"
                                Background="{DynamicResource SettingCardBackground}">
                            <icons:FileDocumentIcon Size="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource NotificationSuccessIconBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveComparison.TargetHeader}"
                                       ToolTip="{Binding ActiveComparison.TargetHeader}"
                                       Style="{StaticResource ComparePaneTitleStyle}"/>
                            <TextBlock Text="{Binding ActiveComparison.TargetFile.FilePath}"
                                       ToolTip="{Binding ActiveComparison.TargetFile.FilePath}"
                                       Style="{StaticResource ComparePanePathStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Grid.Column="2" Margin="9,0,9,8" ClipToBounds="True" IsHitTestVisible="False">
                    <Border Width="{Binding DiffGutterWidth}" HorizontalAlignment="Left"
                            Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
                </Grid>
                <ListBox x:Name="ComparisonRowsListBox" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,0,0,8"
                         ItemsSource="{Binding ActiveComparison.Rows}"
                         Style="{StaticResource CompareLinesListStyle}"/>
                <TabControl x:Name="ComparisonTabControl" Grid.Row="2" Grid.Column="2"
                            ItemsSource="{Binding ComparisonResults}"
                            SelectedItem="{Binding ActiveComparison, Mode=TwoWay}"
                            ItemContainerStyle="{StaticResource CompareTargetTabStyle}">
                    <TabControl.Style>
                        <Style TargetType="TabControl">
                            <Setter Property="Margin" Value="8,0,8,8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ComparedFilesCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ComparedFilesCount}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Style>
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TargetTitle}" FontFamily="{DynamicResource WinstonRegular}"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="14,10"
                MinHeight="48"
                CornerRadius="8"
                Background="{DynamicResource SettingCardBackground}"
                BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="26" Height="26" Margin="0,0,16,0"
                      Visibility="{Binding ResultsPanelVisibility}">
                    <Ellipse Fill="{DynamicResource NotificationSuccessIconBrush}"/>
                    <Path Data="M 7,13 L 11,17 L 19,9"
                          Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Grid>
                <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"
                           FontFamily="{DynamicResource WinstonMedium}" FontSize="13"
                           Foreground="{DynamicResource ForegrounfBrushes85}"/>
                <Border Width="1" Height="20" Margin="20,0"
                        Background="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                        Visibility="{Binding ResultsPanelVisibility}"/>
                <TextBlock VerticalAlignment="Center"
                           Visibility="{Binding ResultsPanelVisibility}"
                           FontFamily="{DynamicResource WinstonRegular}" FontSize="13"
                           Foreground="{DynamicResource ForegrounfBrushes85}">
                    <Run Text="Файлов справа: "/><Run Text="{Binding ComparedFilesCount, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

