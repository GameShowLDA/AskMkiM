<UserControl x:Class="Ask.UI.Features.ServiceTools.Gpt.Modes.AcwMode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:Ask.UI.Shared.Controls"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1180"
             Background="Transparent"
             Foreground="{DynamicResource ForegrounfBrushes}">
    <UserControl.Resources>
        <Style x:Key="ParameterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes85}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ParameterRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="{x:Type shared:NumericComboBox}"
               BasedOn="{StaticResource CustomComboBoxStyle}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1280"
              Margin="22"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="16,12"
                    Background="{DynamicResource SettingCardBackground}"
                    BorderBrush="{DynamicResource SettingCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Режим ACW"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,4,0,0"
                                   Text="Испытание изоляции переменным напряжением"
                                   Foreground="{DynamicResource ForegrounfBrushes85}"
                                   FontSize="15"
                                   Opacity="0.7"/>
                    </StackPanel>
                    <Button x:Name="ConnectButton"
                            Grid.Column="1"
                            MinWidth="210"
                            Height="40"
                            Content="Включить"
                            Background="{DynamicResource GreenColorSolidColorBrush}"
                            BorderBrush="{DynamicResource GreenColorSolidColorBrush}"
                            Foreground="White"
                            Style="{DynamicResource ButtonStyleV8}"
                            PreviewMouseDown="Button_PreviewMouseDown"/>
                </Grid>
            </Border>

            <Grid x:Name="PanelManagment"
                  Grid.Row="1"
                  Margin="0,14,0,0"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SettingCardBackground}"
                        BorderBrush="{DynamicResource SettingCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Margin="18,16,18,12"
                                   Text="Параметры испытания"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Border Grid.Row="1" Style="{StaticResource ParameterRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Напряжение ACW" Style="{StaticResource ParameterLabelStyle}"/>
                                <shared:NumericComboBox x:Name="VoltageSlider" Grid.Column="1"
                                                        Minimum="100" Maximum="1000" Increment="100" Unit="В"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource ParameterRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Верхний предел тока" Style="{StaticResource ParameterLabelStyle}"/>
                                <shared:NumericComboBox x:Name="ChiSlider" Grid.Column="1"
                                                        Minimum="1" Maximum="110" Increment="1" Unit="мА"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Style="{StaticResource ParameterRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Нижний предел тока" Style="{StaticResource ParameterLabelStyle}"/>
                                <shared:NumericComboBox x:Name="CloSlider" Grid.Column="1"
                                                        Minimum="0" Maximum="109" Increment="1" Unit="мА"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="4" Style="{StaticResource ParameterRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Время теста" Style="{StaticResource ParameterLabelStyle}"/>
                                <shared:NumericComboBox x:Name="TimeSlider" Grid.Column="1"
                                                        Minimum="0.5" Maximum="10" Increment="0.1"
                                                        DecimalPlaces="1" Unit="сек"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="5" Style="{StaticResource ParameterRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Время нарастания" Style="{StaticResource ParameterLabelStyle}"/>
                                <shared:NumericComboBox x:Name="RampTimeSlider" Grid.Column="1"
                                                        Minimum="0.1" Maximum="10" Increment="0.1"
                                                        DecimalPlaces="1" Unit="сек"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="6" Style="{StaticResource ParameterRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Частота" Style="{StaticResource ParameterLabelStyle}"/>
                                <ComboBox x:Name="FrequencyComboBox"
                                          Grid.Column="1"
                                          Width="160"
                                          Height="36"
                                          SelectedIndex="0"
                                          Style="{StaticResource CustomComboBoxStyle}">
                                    <ComboBoxItem Content="50 Гц"/>
                                    <ComboBoxItem Content="60 Гц"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Grid.Row="7" Style="{StaticResource ParameterRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Смещение" Style="{StaticResource ParameterLabelStyle}"/>
                                <shared:NumericComboBox x:Name="RefSlider" Grid.Column="1"
                                                        Minimum="0" Maximum="109" Increment="1" Unit="мА"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="8" Style="{StaticResource ParameterRowStyle}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ток дуги" Style="{StaticResource ParameterLabelStyle}"/>
                                <shared:NumericComboBox x:Name="ArcCurrentSlider" Grid.Column="1"
                                                        Minimum="2" Maximum="200" Increment="1"
                                                        DecimalPlaces="3" Unit="мА"/>
                            </Grid>
                        </Border>
                        <Button Grid.Row="9"
                                Height="42"
                                Margin="16"
                                Content="Сохранить параметры"
                                Style="{DynamicResource ButtonStyleV8}"
                                PreviewMouseDown="Button_PreviewMouseDown_1"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="18"
                            Background="{DynamicResource SettingCardBackground}"
                            BorderBrush="{DynamicResource SettingCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Последнее считывание"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="LastReadTimeText"
                                       Margin="0,5,0,14"
                                       Text="Нет данных"
                                       Foreground="{DynamicResource ForegrounfBrushes85}"
                                       FontSize="14"/>
                            <TextBlock x:Name="VoltageValueText" Text="Напряжение ACW: Нет данных" Margin="0,4"/>
                            <TextBlock x:Name="ChiValueText" Text="Верхний предел тока: Нет данных" Margin="0,4"/>
                            <TextBlock x:Name="CloValueText" Text="Нижний предел тока: Нет данных" Margin="0,4"/>
                            <TextBlock x:Name="TimeValueText" Text="Время теста: Нет данных" Margin="0,4"/>
                            <TextBlock x:Name="FrequencyValueText" Text="Частота: Нет данных" Margin="0,4"/>
                            <TextBlock x:Name="RefValueText" Text="Смещение: Нет данных" Margin="0,4"/>
                            <TextBlock x:Name="ArcCurrentValueText" Text="Ток дуги: Нет данных" Margin="0,4"/>
                            <Button Margin="0,16,0,0"
                                    Height="38"
                                    Content="Считать с устройства"
                                    Style="{DynamicResource ButtonStyleV11}"
                                    Click="ReadConfigurationButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Padding="18"
                            Background="{DynamicResource SettingCardBackground}"
                            BorderBrush="{DynamicResource SettingCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Контрольное испытание"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="TestResultText"
                                       Margin="0,8,0,14"
                                       Text="Результат: Нет данных"
                                       Foreground="{DynamicResource ForegrounfBrushes85}"/>
                            <Button Height="38"
                                    Content="Запустить тест"
                                    Style="{DynamicResource ButtonStyleV11}"
                                    Click="StartTestButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
