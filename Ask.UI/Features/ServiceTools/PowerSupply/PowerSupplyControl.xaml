<UserControl x:Class="Ask.UI.Features.ServiceTools.PowerSupply.PowerSupplyControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:Ask.UI.Shared.Controls"
    Foreground="{DynamicResource ForegrounfBrushes}">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource SettingCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.72"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingCardBorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource ButtonStyleBase}">
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="On" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{DynamicResource GreenColorSolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GreenColorSolidColorBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Off" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{DynamicResource RedColorSolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RedColorSolidColorBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="18" MinWidth="720" MaxWidth="1000">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Внешние источники питания" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" Text="Выберите или добавьте источник питания."
                               TextWrapping="Wrap" FontSize="14"/>
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Отменить операцию" Style="{StaticResource Action}"
                        IsEnabled="False" Click="Cancel_Click"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="OperationPanel">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Источник из конфигурации оборудования" Style="{StaticResource Title}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SourceComboBox" Height="42" Margin="0,0,12,8"
                                      Style="{DynamicResource CustomComboBoxStyle}" SelectionChanged="Source_SelectionChanged"
                                      AutomationProperties.Name="Источник питания выбранного тестера">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock><Run Text="{Binding Name}"/><Run Text=" · тестер "/><Run Text="{Binding NumberChassis}"/><Run Text=" · №"/><Run Text="{Binding Number}"/></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Обновить" Style="{StaticResource Action}" Click="Reload_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Подключение и выход" Style="{StaticResource Title}" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button Content="Подключить" Style="{StaticResource Action}" Click="Connect_Click"/>
                            <Button Content="Отключить связь" Style="{StaticResource Action}" Click="Disconnect_Click"/>
                            <Button Content="Выход: включить" Style="{StaticResource On}" Click="OutputOn_Click"/>
                            <Button Content="Выход: выключить" Style="{StaticResource Off}" Click="OutputOff_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="OutputText" Text="Состояние выхода: не прочитано" FontSize="16" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Уставки" Style="{StaticResource Title}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="VoltageRangeText" Text="Напряжение, В" VerticalAlignment="Center" FontSize="16"/>
                            <shared:NumericComboBox x:Name="VoltageInput" Grid.Column="1" Minimum="0" Maximum="150" Increment="0.1" DecimalPlaces="1"
                                Height="42" Margin="0,0,14,10" Style="{DynamicResource CustomComboBoxStyle}" AutomationProperties.Name="Уставка напряжения в вольтах"/>
                            <Button Grid.Column="2" Content="Установить U" Style="{StaticResource Action}" Click="SetVoltage_Click"/>
                            <TextBlock x:Name="CurrentRangeText" Grid.Row="1" Text="Ограничение тока, мА" VerticalAlignment="Center" FontSize="16"/>
                            <shared:NumericComboBox x:Name="CurrentInput" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="5000" Increment="1" DecimalPlaces="0"
                                Height="42" Margin="0,0,14,0" Style="{DynamicResource CustomComboBoxStyle}" AutomationProperties.Name="Ограничение тока в миллиамперах"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Установить I" Style="{StaticResource Action}" Click="SetCurrent_Click"/>
                        </Grid>
                        <TextBlock x:Name="SetpointsText" Text="Уставки прибора: не прочитаны" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="15"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Измерения и состояние" Style="{StaticResource Title}"/>
                        <Button Content="Прочитать параметры" Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,14,0,8" Click="Read_Click"/>
                        <TextBlock x:Name="MeasurementsText" Text="Напряжение: — В    Ток: — мА" FontSize="22" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReadTimeText" Margin="0,8,0,0" Opacity="0.7" FontSize="13"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
