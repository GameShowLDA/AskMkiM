<UserControl x:Class="Ask.UI.Features.ServiceTools.SwitchingDevice.SwitchingDeviceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="900"
             Foreground="{DynamicResource ForegrounfBrushes}">
    <UserControl.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource SettingCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
        </Style>
        <Style x:Key="ActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonStyleV11}">
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ConnectButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource GreenColorSolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GreenColorSolidColorBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DisconnectButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource RedColorSolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RedColorSolidColorBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.72"/>
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,16"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="18">
        <Grid MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="DeviceStatusIndicator"
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource GreenColorSolidColorBrush}"
                                    CornerRadius="5"/>
                            <TextBlock Text="Устройство коммутации шин"
                                       Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="DeviceStatusText"
                                   Margin="0,5,0,0"
                                   Text="УКШ загружается…"
                                   FontSize="15"
                                   Opacity="0.7"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="140"
                            Content="Обновить"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="RefreshButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.92*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Margin="0,0,0,16" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Быстрая коммутация"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Основные подключения и общие линии устройства."
                                       Style="{StaticResource HintStyle}"/>
                            <TextBlock Text="Рабочая шина" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="BusComboBox"
                                      Height="42"
                                      Margin="0,0,0,16"
                                      SelectedIndex="0"
                                      FontSize="16"
                                      Style="{StaticResource CustomComboBoxStyle}"/>
                            <TextBlock Text="Мультиметр" Style="{StaticResource FieldLabelStyle}"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Подключить"
                                        Style="{StaticResource ConnectButtonStyle}"
                                        Click="ConnectMultimeterButton_Click"/>
                                <Button Content="Отключить"
                                        Style="{StaticResource DisconnectButtonStyle}"
                                        Click="DisconnectMultimeterButton_Click"/>
                            </WrapPanel>
                            <Separator Margin="0,2,0,14" Opacity="0.18"/>
                            <TextBlock Text="Пробойная установка" Style="{StaticResource FieldLabelStyle}"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="ППУ подключить"
                                        Style="{StaticResource ConnectButtonStyle}"
                                        Click="ConnectBreakdownTesterButton_Click"/>
                                <Button Content="ППУ отключить"
                                        Style="{StaticResource DisconnectButtonStyle}"
                                        Click="DisconnectBreakdownTesterButton_Click"/>
                                <Button Content="ППУ + мультиметр"
                                        Style="{StaticResource ConnectButtonStyle}"
                                        Click="ConnectBreakdownAndMeterButton_Click"/>
                                <Button Content="Отключить оба"
                                        Style="{StaticResource DisconnectButtonStyle}"
                                        Click="DisconnectBreakdownAndMeterButton_Click"/>
                            </WrapPanel>
                            <Separator Margin="0,2,0,14" Opacity="0.18"/>
                            <TextBlock Text="Общие линии" Style="{StaticResource FieldLabelStyle}"/>
                            <WrapPanel>
                                <Button Content="Все шины: вкл."
                                        Style="{StaticResource ConnectButtonStyle}"
                                        Click="ConnectAllBusesButton_Click"/>
                                <Button Content="Все шины: выкл."
                                        Style="{StaticResource DisconnectButtonStyle}"
                                        Click="DisconnectAllBusesButton_Click"/>
                                <Button Content="Делитель: вкл."
                                        Style="{StaticResource ConnectButtonStyle}"
                                        Click="EnableDividerButton_Click"/>
                                <Button Content="Делитель: выкл."
                                        Style="{StaticResource DisconnectButtonStyle}"
                                        Click="DisableDividerButton_Click"/>
                            </WrapPanel>
                            <Border Margin="0,8,0,0"
                                    Padding="12,10"
                                    Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                    CornerRadius="8">
                                <TextBlock Text="ПИНТ временно недоступен в runtime."
                                           FontSize="13"
                                           Opacity="0.62"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,16" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Реле и компоненты"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Ручное управление отдельными каналами."
                                       Style="{StaticResource HintStyle}"/>
                            <TextBlock Text="Номер реле" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RelayNumberTextBox"
                                         Style="{StaticResource InputStyle}"
                                         ToolTip="Номер реле"/>
                                <Button Grid.Column="2"
                                        Content="Замкнуть"
                                        Style="{StaticResource ConnectButtonStyle}"
                                        Click="ConnectRelayButton_Click"/>
                                <Button Grid.Column="4"
                                        Content="Разомкнуть"
                                        Style="{StaticResource DisconnectButtonStyle}"
                                        Click="DisconnectRelayButton_Click"/>
                            </Grid>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Все реле: вкл."
                                        Style="{StaticResource ConnectButtonStyle}"
                                        Click="EnableRelayButton_Click"/>
                                <Button Content="Все реле: выкл."
                                        Style="{StaticResource DisconnectButtonStyle}"
                                        Click="DisableRelayButton_Click"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Резистор" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="ResistorNumberTextBox"
                                             Margin="0,0,0,10"
                                             Style="{StaticResource InputStyle}"/>
                                    <WrapPanel>
                                        <Button Content="Подключить"
                                                Style="{StaticResource ConnectButtonStyle}"
                                                Click="ConnectResistorButton_Click"/>
                                        <Button Content="Отключить"
                                                Style="{StaticResource DisconnectButtonStyle}"
                                                Click="DisconnectResistorButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Конденсатор" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="CapacitorNumberTextBox"
                                             Margin="0,0,0,10"
                                             Style="{StaticResource InputStyle}"/>
                                    <WrapPanel>
                                        <Button Content="Подключить"
                                                Style="{StaticResource ConnectButtonStyle}"
                                                Click="ConnectCapacitorButton_Click"/>
                                        <Button Content="Отключить"
                                                Style="{StaticResource DisconnectButtonStyle}"
                                                Click="DisconnectCapacitorButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Margin="0,0,0,16" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Цепи самоконтроля"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Выберите цепь и контакт для ручного замыкания или размыкания."
                                       Style="{StaticResource HintStyle}"/>
                            <TextBlock Text="Тип цепи" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="SelfTestTypeComboBox"
                                      Height="42"
                                      Margin="0,0,0,12"
                                      FontSize="16"
                                      Style="{StaticResource CustomComboBoxStyle}"
                                      SelectionChanged="SelfTestTypeComboBox_SelectionChanged"/>
                            <TextBlock Text="Контакт" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="SelfTestContactComboBox"
                                      Height="42"
                                      Margin="0,0,0,12"
                                      FontSize="16"
                                      Style="{StaticResource CustomComboBoxStyle}"
                                      SelectionChanged="SelfTestContactComboBox_SelectionChanged"/>
                            <Border Margin="0,0,0,14"
                                    Padding="13,11"
                                    Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                    CornerRadius="8">
                                <TextBlock x:Name="SelfTestCircuitNameText"
                                           Text="Цепь не выбрана"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <WrapPanel>
                                <Button Content="Подключить цепь"
                                        Style="{StaticResource ConnectButtonStyle}"
                                        Click="ConnectSelfTestCircuitButton_Click"/>
                                <Button Content="Отключить цепь"
                                        Style="{StaticResource DisconnectButtonStyle}"
                                        Click="DisconnectSelfTestCircuitButton_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Активные подключения"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <Border Grid.Column="1"
                                        Padding="10,4"
                                        Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                        CornerRadius="10">
                                    <TextBlock Text="LIVE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource GreenColorSolidColorBrush}"/>
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="ConnectionsList"
                                          Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="13,10"
                                                Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                                CornerRadius="8">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="15"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoConnectionsText"
                                       Margin="0,14,0,0"
                                       Text="Сейчас нет зарегистрированных подключений."
                                       FontSize="14"
                                       Opacity="0.62"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
