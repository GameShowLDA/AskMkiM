<?xml version="1.0"?>

<SyntaxDefinition name="MKI" extensions=".asktrace;.lst;.lstw" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="PKData" foreground="#4CAF50"/>
	<Color name="ProtocolMain" foreground="#90EE90" fontWeight="bold"/>
	<Color name="PurposeAndResults" foreground="#90EE90" />
	<Color name="Voltage" foreground="#FFD700" />
	<Color name="Time" foreground="#FFD700" />
	<Color name="Error" foreground="#f1301b" />
	<Color name="Mnemonic" foreground="#90EE90" />
	<Color name="CommandNumber" foreground="#00BFFF" />
	<Color name="OkParam" foreground="#FFB300" />
	<Color name="RootDebug" foreground="#8CF3F0F9" />
	<Color name="StatusCommand" foreground="#E69138" />
	<Color name="StatusCommandBlock" foreground="#5DADE2" />
	<Color name="StatusInfo" foreground="#F3F0F9" />
	<Color name="StatusSuccess" foreground="#2FA84F" />
	<Color name="StatusError" foreground="#F1301B" />
	<Color name="StatusTime" foreground="#9ACD32" />

	<RuleSet ignoreCase="true">
		<Rule color="ProtocolMain">^\s*(?:Версия|Ревизия)\s+ПО:</Rule>
		<Rule color="ProtocolMain">(?&lt;=^Протокол\([^\r\n)]*\)\s+от\s)\d{2}\.\d{2}\.\d{4}</Rule>
		<Rule color="ProtocolMain">(?&lt;=сборочной\s+единицы\s)\S+\s+Зав\.N\s+\S+</Rule>
		<Rule color="ProtocolMain">(?&lt;=^Программа\s+проверки:\s*)\S+</Rule>
		<Rule color="RootDebug">⁣⁣[^⁣]*</Rule>
		<Rule color="StatusCommand">⁣​[^⁣]*</Rule>
		<Rule color="StatusCommandBlock">⁣‌[^⁣]*</Rule>
		<Rule color="StatusSuccess">⁣‍[^⁣]*</Rule>
		<Rule color="StatusError">⁣⁠[^⁣]*</Rule>
		<Rule color="StatusInfo">⁣﻿[^⁣]*</Rule>
		<Rule color="StatusTime">⁣⁢[^⁣]*</Rule>

		<!-- первая строка может начинаться с BOM -->
		<Rule color="ProtocolMain">^\uFEFF?\s*Протокол\s*\([^)]*режим[^)]*\)\s*от</Rule>


		<Rule color="PurposeAndResults">^\s*Цель\s+проверки:</Rule>
		<Rule color="PurposeAndResults">^\s*Оборудование:</Rule>
		<Rule color="PurposeAndResults">^\s*Программа\s+проверки:?</Rule>
		<Rule color="Time">^\s*Время\s+начала\s+измерений:</Rule>
		<Rule color="Time">^\s*Время\s+окончания\s+измерений:</Rule>
		<Rule color="Time">^\s*Время\s+выполнения:</Rule>

		<Rule color="PurposeAndResults">^\s*Обрывов:</Rule>
		<Rule color="PurposeAndResults">^\s*Замыканий:</Rule>
		<Rule color="PurposeAndResults">^\s*Нарушений\s+изоляции:</Rule>
		<Rule color="ProtocolMain">^\s*Заключение:</Rule>
		<Rule color="ProtocolMain">^\s*Исполнитель(?=:)</Rule>
		<Rule color="PKData">^\s*Представитель\s+ОК:</Rule>
		<Rule color="ProtocolMain">^\s*Представитель\s+ОТК(?=:)</Rule>
		<Rule color="ProtocolMain">^\s*Представитель\s+заказчика\s*\(ВП\)(?=:)</Rule>

		<Rule color="Error">^\s*Ошибки\s+программы.*:</Rule>
		<Rule color="Error">^\s*Ошибки\s+команды:</Rule>

		<!-- Номер команды (вместе с номером строки, чтобы не перекрывало) -->
		<Rule color="Error">^ERR\d+</Rule>
		<Rule color="CommandNumber">(?&lt;=^ERR\d+\s)\d+</Rule>
		<Rule color="CommandNumber">^DOC\d+\s*\d+</Rule>

		<!-- Мнемоника -->
		<Rule color="Mnemonic">(?&lt;=^(?:ERR|DOC)\d+\s+\d+\s)(СИ|ОК|СП|РМ|ЦУ|ПР|ПИ|КЦ|УП|КС|ИЕ|ЭТ|НЭ|ПТ|ОТ|ОС)\b</Rule>
		<Rule color="OkParam">\[\d+(?:\.\d+)*\]</Rule>

		<!-- Между двоеточиями -->
		<Rule>:\s*[^:]+:</Rule>

		<Rule color="Error">\[БРАК\]</Rule>


	</RuleSet>


</SyntaxDefinition>
