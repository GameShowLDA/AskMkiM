<UserControl x:Class="Ask.UI.Controls.ProtocolNew.SavedProtocolPairUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:TextEditorControl="clr-namespace:Ask.UI.Controls.TextEditorControl">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <TextEditorControl:TextEditorUI x:Name="ExecutionProtocolEditor"
                                            IsReadOnly="True"/>
            <ContentControl x:Name="StructuredExecutionProtocol" Visibility="Collapsed"/>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      Margin="5,0"
                      Background="{StaticResource VioletColorSolidColorBrush}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>

        <TextEditorControl:TextEditorUI x:Name="ResultProtocolEditor"
                                        Grid.Column="2"
                                        IsReadOnly="True"/>
    </Grid>
</UserControl>
