<UserControl x:Class="Ask.UI.Controls.ProtocolNew.SavedProtocolPairUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icons="clr-namespace:Ask.UI.Shared.Components.Icons"
             xmlns:TextEditorControl="clr-namespace:Ask.UI.Controls.TextEditorControl">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <TextEditorControl:TextEditorUI x:Name="ExecutionProtocolEditor"
                                            IsReadOnly="True"/>
            <ContentControl x:Name="StructuredExecutionProtocol" Visibility="Collapsed"/>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      Margin="5,0"
                      Background="{StaticResource VioletColorSolidColorBrush}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Height="40" Margin="0,0,0,5" Padding="6,4"
                    Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"
                    Style="{DynamicResource SettingCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Click="PrintButton_Click" ToolTip="Печать протокола"
                            VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}">
                        <Icons:PrintIcon Size="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    </Button>
                    <Button Click="ExportPdfButton_Click" ToolTip="Экспортировать протокол в PDF"
                            Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}">
                        <Icons:ExportConfigIcon Size="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    </Button>
                    <TextBlock Text="Итоговый протокол" Margin="12,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource WinstonBold}" FontSize="16"
                               Foreground="{DynamicResource ForegrounfBrushes}"/>
                </StackPanel>
            </Border>
            <TextEditorControl:TextEditorUI x:Name="ResultProtocolEditor"
                                            Grid.Row="1" IsReadOnly="True"/>
        </Grid>
    </Grid>
</UserControl>
