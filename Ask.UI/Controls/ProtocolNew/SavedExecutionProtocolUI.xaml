<UserControl x:Class="Ask.UI.Controls.ProtocolNew.SavedExecutionProtocolUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icons="clr-namespace:Ask.UI.Shared.Components.Icons"
             xmlns:protocol="clr-namespace:Ask.UI.Components.ProtocolListBox">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="ActionPanel" Visibility="Collapsed" Height="40" Margin="0,0,0,5" Padding="6,4"
                Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"
                Style="{DynamicResource SettingCardStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Click="PrintButton_Click" ToolTip="Печать протокола"
                        VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}">
                    <Icons:PrintIcon Size="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                </Button>
                <Button Click="ExportPdfButton_Click" ToolTip="Экспортировать протокол в PDF"
                        Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}">
                    <Icons:ExportConfigIcon Size="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                </Button>
            </StackPanel>
        </Border>
        <protocol:ProtocolListBoxUI x:Name="Protocol" Grid.Row="1"/>
    </Grid>
</UserControl>
