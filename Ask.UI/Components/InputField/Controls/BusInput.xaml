<UserControl x:Class="Ask.UI.Components.InputField.Controls.BusInput"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FocusVisualStyle="{x:Null}"
             d:DesignWidth="250">

    <Border CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBorder"
                    Background="{DynamicResource TestsInputBackgroundHeaderPanelBrush}"
                    Padding="5"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock x:Name="EditingHeaderTextBlock"
                               Text="{Binding Header, ElementName=Root}"
                               FontFamily="{DynamicResource WinstonMedium}"
                               TextWrapping="Wrap"
                               FontSize="18"
                               Foreground="{DynamicResource TestsInputHeaderSolidColorBrush}"
                               Margin="0,5"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ExecutionHeaderTextBlock"
                               FontFamily="{DynamicResource WinstonMedium}"
                               TextWrapping="Wrap"
                               FontSize="18"
                               Foreground="{DynamicResource TestsInputHeaderSolidColorBrush}"
                               Margin="0,5"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed">
                        <Run Text="{Binding ExecutionHeader, ElementName=Root, Mode=OneWay}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding ExecutionValue, ElementName=Root, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <Border x:Name="SelectionBorder"
                    Grid.Row="1"
                    Background="{DynamicResource TestsInputBackgroundInputPanelBrush}"
                    CornerRadius="0,0,10,10">
                <Grid>
                    <Grid x:Name="BusPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="BusACheckBox"
                                  Margin="5"
                                  Width="20"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource AnimatedSwitch}"
                                  Checked="Bus_Checked"
                                  Unchecked="Bus_Unchecked"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Source={StaticResource LS_Input_Bus_A}, Path=Value}"
                                   FontFamily="{DynamicResource WinstonMedium}"
                                   FontSize="18"
                                   Foreground="{DynamicResource TestsInputHeaderSolidColorBrush}"
                                   VerticalAlignment="Center"
                                   Padding="5"/>

                        <CheckBox x:Name="BusBCheckBox"
                                  Grid.Row="1"
                                  Margin="5"
                                  Width="20"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource AnimatedSwitch}"
                                  Checked="Bus_Checked"
                                  Unchecked="Bus_Unchecked"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Source={StaticResource LS_Input_Bus_B}, Path=Value}"
                                   FontFamily="{DynamicResource WinstonMedium}"
                                   FontSize="18"
                                   Foreground="{DynamicResource TestsInputHeaderSolidColorBrush}"
                                   VerticalAlignment="Center"
                                   Padding="5"/>
                    </Grid>

                    <Grid x:Name="BusGroupPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="BusAB1CheckBox"
                                  Margin="5"
                                  Width="20"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource AnimatedSwitch}"
                                  Checked="BusGroup_Checked"
                                  Unchecked="BusGroup_Unchecked"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Source={StaticResource LS_Input_Bus_Group_AB1}, Path=Value}"
                                   FontFamily="{DynamicResource WinstonMedium}"
                                   FontSize="18"
                                   Foreground="{DynamicResource TestsInputHeaderSolidColorBrush}"
                                   VerticalAlignment="Center"
                                   Padding="5"/>

                        <CheckBox x:Name="BusAB2CheckBox"
                                  Grid.Row="1"
                                  Margin="5"
                                  Width="20"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource AnimatedSwitch}"
                                  Checked="BusGroup_Checked"
                                  Unchecked="BusGroup_Unchecked"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Source={StaticResource LS_Input_Bus_Group_AB2}, Path=Value}"
                                   FontFamily="{DynamicResource WinstonMedium}"
                                   FontSize="18"
                                   Foreground="{DynamicResource TestsInputHeaderSolidColorBrush}"
                                   VerticalAlignment="Center"
                                   Padding="5"/>

                        <CheckBox x:Name="BusAB3CheckBox"
                                  Grid.Row="2"
                                  Margin="5"
                                  Width="20"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource AnimatedSwitch}"
                                  Checked="BusGroup_Checked"
                                  Unchecked="BusGroup_Unchecked"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding Source={StaticResource LS_Input_Bus_Group_AB3}, Path=Value}"
                                   FontFamily="{DynamicResource WinstonMedium}"
                                   FontSize="18"
                                   Foreground="{DynamicResource TestsInputHeaderSolidColorBrush}"
                                   VerticalAlignment="Center"
                                   Padding="5"/>

                        <CheckBox x:Name="BusAB4CheckBox"
                                  Grid.Row="3"
                                  Margin="5"
                                  Width="20"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource AnimatedSwitch}"
                                  Checked="BusGroup_Checked"
                                  Unchecked="BusGroup_Unchecked"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding Source={StaticResource LS_Input_Bus_Group_AB4}, Path=Value}"
                                   FontFamily="{DynamicResource WinstonMedium}"
                                   FontSize="18"
                                   Foreground="{DynamicResource TestsInputHeaderSolidColorBrush}"
                                   VerticalAlignment="Center"
                                   Padding="5"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
