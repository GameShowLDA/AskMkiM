<UserControl x:Class="Ask.UI.Components.InputField.InputField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ask.UI.Components.InputField"
             xmlns:inputControls="clr-namespace:Ask.UI.Components.TextBoxPlaceholder"
             xmlns:dataControls="clr-namespace:Ask.UI.Components.InputField.Controls"
             mc:Ignorable="d" 
             FocusVisualStyle="{x:Null}"
             d:DesignHeight="910" d:DesignWidth="250">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid x:Name="TestInputGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <!--Проверяемый модуль-->
            <dataControls:ModuleInput Grid.Row="0"
                                      x:Name="TestedNumberBox"
                                      Margin="5"
                                      Header="Проверяемый модуль a.b"
                                      ExecutionHeader="Проверяемый модуль"
                                      Placeholder="{Binding Source={StaticResource LS_Input_Placeholder}, Path=Value}"/>

            <!--Проверяющий модуль-->
            <dataControls:ModuleInput Grid.Row="1"
                                      x:Name="TesterNumberBox"
                                      Margin="5"
                                      Header="Проверяющий модуль a.b"
                                      ExecutionHeader="Проверяющий модуль"
                                      Placeholder="{Binding Source={StaticResource LS_Input_Placeholder}, Path=Value}"
                                      IsNumberInputEnabled="False"/>

            <!--Диапазон проверки-->
            <Border  Margin="5" Grid.Row="2" Background="{DynamicResource TestsInputBackgroundHeaderPanelBrush}" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Name="headerTestRange" 
                               FontFamily="{DynamicResource WinstonMedium}"
                               TextWrapping="Wrap" 
                               TextTrimming="None" 
                               Text="Диапазон проверки" 
                               FontSize="18" 
                               Foreground="{DynamicResource TestsInputHeaderSolidColorBrush}"  
                               Margin="0,5" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" Padding="5"/>
                    <inputControls:TextBoxPlaceholder Grid.Row="1" 
                               FontFamily="{DynamicResource WinstonLight}" 
                               x:Name="TestRangeBox" 
                               Placeholder="{Binding Source={StaticResource LS_Input_Placeholder}, Path=Value}" 
                               Height="40" 
                               AllowRange="True"
                               Background="{DynamicResource TestsInputBackgroundInputPanelBrush}"/>

                </Grid>
            </Border>

        </Grid>

        <Grid x:Name="TestStepParametersGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <dataControls:PointInput
                Header="{Binding Source={StaticResource LS_Input_First_Title}, Path=Value}"
                ExecutionHeader="Первая точка"
                Role="First"
                Placeholder="{Binding Source={StaticResource LS_Input_Placeholder}, Path=Value}"
                Margin="5"
                x:Name="FirstPointTextBox"
                Text="1.6.1"
                />

            <dataControls:PointInput
                Header="{Binding Source={StaticResource LS_Input_Second_Title}, Path=Value}"
                ExecutionHeader="Вторая точка"
                Role="Second"
                Placeholder="{Binding Source={StaticResource LS_Input_Placeholder}, Path=Value}"
                Margin="5"
                x:Name="LastPointTextBox"
                Text="1.6.100"
                Grid.Row="1"
                />

            <!--Электрический параметр-->
            <dataControls:ElectricalInput Grid.Row="2"
                                          x:Name="ElectricalTextBox"
                                          Margin="5"
                                          Header="{Binding Source={StaticResource LS_Input_Electrical_Title}, Path=Value}"
                                          ExecutionHeader="Электрический параметр"
                                          Placeholder="{Binding Source={StaticResource LS_Input_Placeholder}, Path=Value}"
                                          Unit="{Binding UnitElectrical, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!--Время выполнения в сек.-->
            <dataControls:TimeInput Grid.Row="3"
                                    x:Name="TimeTextBox"
                                    Margin="5"
                                    Header="{Binding Source={StaticResource LS_Input_Time_Title}, Path=Value}"
                                    ExecutionHeader="Время выполнения"
                                    Placeholder="{Binding Source={StaticResource LS_Input_Placeholder_Time}, Path=Value}"
                                    Unit="{Binding Source={StaticResource LS_Unit_Seconds}, Path=Value}"
                                    Visibility="{Binding IsTimeVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>

            <!--Время нарастания в сек.-->
            <dataControls:TimeInput Grid.Row="4"
                                    x:Name="TimeRampTextBox"
                                    Margin="5"
                                    Header="{Binding Source={StaticResource LS_Input_TimeRamp_Title}, Path=Value}"
                                    ExecutionHeader="Время нарастания"
                                    Placeholder="{Binding Source={StaticResource LS_Input_Placeholder_Time}, Path=Value}"
                                    Unit="{Binding Source={StaticResource LS_Unit_Seconds}, Path=Value}"
                                    Visibility="{Binding IsTimeRampVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>

            <!--Напряжение в В.-->
            <dataControls:ElectricalInput Grid.Row="5"
                                          x:Name="VoltageTextBox"
                                          Margin="5"
                                          Header="{Binding Source={StaticResource LS_Input_Voltage_Title}, Path=Value}"
                                          ExecutionHeader="Напряжение"
                                          Placeholder="{Binding Source={StaticResource LS_Input_Placeholder}, Path=Value}"
                                          Unit="{Binding Source={StaticResource LS_Unit_Volts}, Path=Value}"
                                          Visibility="{Binding IsVoltageVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>

            <!--Шины для проверки-->
            <dataControls:BusInput Grid.Row="6"
                                   x:Name="BusSelector"
                                   Margin="5"
                                   Header="{Binding Source={StaticResource LS_Input_Bus_Title}, Path=Value}"
                                   ExecutionHeader="Шина для проверки"
                                   SelectionMode="Bus"
                                   Visibility="{Binding IsBusVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>

            <!-- Группа шин (AB1..AB4) -->
            <dataControls:BusInput Grid.Row="7"
                                   x:Name="BusGroupSelector"
                                   Margin="5"
                                   Header="{Binding Source={StaticResource LS_Input_Bus_Group_Title}, Path=Value}"
                                   ExecutionHeader="Группа шин"
                                   SelectionMode="BusGroup"
                                   Visibility="{Binding IsBusGroupVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>

</UserControl>
