<UserControl x:Class="Ask.UI.Components.ComSettingsComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ask.UI.Components"
             mc:Ignorable="d" 
             d:DesignWidth="400">

    <Border Background="{DynamicResource PrimarySolidColorBrush}" 
    CornerRadius="10" Margin="0,10"
    Name="COMContainer"
    >
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--Заголовок-->
            <Border Style="{StaticResource DeviceInputSectionTitleBarStyle}">
                <TextBlock Text="COM PORT" Foreground="{DynamicResource ForegroundSolidColorBrush}" 
                   FontSize="20" FontWeight="Bold" Margin="7,0"
                   />
            </Border>

            <!--Выбор COM порта-->
            <Grid Grid.Row="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>

                </Grid.ColumnDefinitions>

                    <TextBlock Text="COM-порт:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundSolidColorBrush}"
                               FontSize="20" FontWeight="Bold" Margin="10,0"/>
                    <ComboBox Grid.Column="1" x:Name="COMPortSelectionBox" MinWidth="100"
                              Style="{StaticResource CustomComboBoxStyle}" VerticalAlignment="Center"
                              SelectionChanged="COMPortSelectionBox_SelectionChanged"/>
           
            </Grid>

            <Grid Grid.Row="2" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="VID:" Foreground="{DynamicResource ForegroundSolidColorBrush}" FontSize="20" FontWeight="Bold" Margin="20,0"/>
                <Border Grid.Column="1" Background="{DynamicResource SettingsConfigDataInputTabloBackgroundSolidColorBrush}" CornerRadius="5">
                    <TextBox x:Name="VIDData" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                                 VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Foreground="{DynamicResource ForegroundSolidColorBrush}"/>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PID:" Foreground="{DynamicResource ForegroundSolidColorBrush}" FontSize="20" FontWeight="Bold" Margin="20,0"/>
                <Border Grid.Column="1" Background="{DynamicResource SettingsConfigDataInputTabloBackgroundSolidColorBrush}" CornerRadius="5">
                    <TextBox x:Name="PIDData" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                 VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Foreground="{DynamicResource ForegroundSolidColorBrush}"/>
                </Border>
            </Grid>

            <!--Бит в секунду-->
            <Grid Grid.Row="4" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Бит в секунду:" Foreground="{DynamicResource ForegroundSolidColorBrush}" 
               FontSize="20" FontWeight="Bold" Margin="7,0"/>

                <ComboBox Grid.Column="1"
              SelectedIndex="3"
              MinWidth="100"
              x:Name="BaudRateSelectionBox"
              Style="{StaticResource CustomComboBoxStyle}"
              VerticalAlignment="Center"
              >
                    <ComboBoxItem>1200</ComboBoxItem>
                    <ComboBoxItem>2400</ComboBoxItem>
                    <ComboBoxItem>4800</ComboBoxItem>
                    <ComboBoxItem>9600</ComboBoxItem>
                    <ComboBoxItem>14400</ComboBoxItem>
                    <ComboBoxItem>19200</ComboBoxItem>
                    <ComboBoxItem>38400</ComboBoxItem>
                    <ComboBoxItem>57600</ComboBoxItem>
                    <ComboBoxItem>115200</ComboBoxItem>
                </ComboBox>
            </Grid>

            <!--Стоповые биты-->
            <Grid Grid.Row="5" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Стоповые биты:" Foreground="{DynamicResource ForegroundSolidColorBrush}" 
                           FontSize="20" FontWeight="Bold" Margin="7,0"/>

                <ComboBox Grid.Column="1"
                          SelectedIndex="0"
                          Style="{StaticResource CustomComboBoxStyle}"
                          VerticalAlignment="Center"
                          x:Name="StopBitsSelectionBox"
                          >
                    <ComboBoxItem>1</ComboBoxItem>
                    <ComboBoxItem>1.5</ComboBoxItem>
                    <ComboBoxItem>2</ComboBoxItem>
                </ComboBox>
            </Grid>

            <!--Биты данных-->
            <Grid Grid.Row="6" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Биты данных:" Foreground="{DynamicResource ForegroundSolidColorBrush}" 
                      FontSize="20" FontWeight="Bold" Margin="7,0"/>


                <ComboBox Grid.Column="1"
                   SelectedIndex="4"
                   MinWidth="100"
                   x:Name="DataBitsSelectionBox"
                   Style="{StaticResource CustomComboBoxStyle}"
                   VerticalAlignment="Center"
                   >
                    <ComboBoxItem>4</ComboBoxItem>
                    <ComboBoxItem>5</ComboBoxItem>
                    <ComboBoxItem>6</ComboBoxItem>
                    <ComboBoxItem>7</ComboBoxItem>
                    <ComboBoxItem>8</ComboBoxItem>
                </ComboBox>
            </Grid>

            <!--Чётность-->
            <Grid Grid.Row="7" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Чётность:" Foreground="{DynamicResource ForegroundSolidColorBrush}" 
                           FontSize="20" FontWeight="Bold" Margin="7,0"/>

                <ComboBox Grid.Column="1"
                          SelectedIndex="2"
                          Style="{StaticResource CustomComboBoxStyle}"
                          VerticalAlignment="Center"
                          x:Name="ParitySelectionBox"
                          >
                    <ComboBoxItem>Чет</ComboBoxItem>
                    <ComboBoxItem>Нечет</ComboBoxItem>
                    <ComboBoxItem>Нет</ComboBoxItem>
                    <ComboBoxItem>Маркер</ComboBoxItem>
                    <ComboBoxItem>Пробел</ComboBoxItem>
                </ComboBox>
            </Grid>

            <!--Управление потоком-->
            <Grid Grid.Row="8" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Управление потоком:" Foreground="{DynamicResource ForegroundSolidColorBrush}" 
                           FontSize="20" FontWeight="Bold" Margin="7,0"/>

                <ComboBox Grid.Column="1"
                          SelectedIndex="2"
                          MinWidth="100"
                          Style="{StaticResource CustomComboBoxStyle}"
                          VerticalAlignment="Center"
                          x:Name="FlowControlSelectionBox"     
                          >
                    <ComboBoxItem>Xon/Xoff</ComboBoxItem>
                    <ComboBoxItem>Аппаратное</ComboBoxItem>
                    <ComboBoxItem>Нет</ComboBoxItem>
                </ComboBox>
            </Grid>
        </Grid>
    </Border>
</UserControl>
