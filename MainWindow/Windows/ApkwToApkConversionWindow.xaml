<Window x:Class="MainWindowProgram.Windows.ApkwToApkConversionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:askUiIcons="clr-namespace:Ask.UI.Shared.Components.Icons;assembly=Ask.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="РљРѕРЅРІРµСЂС‚Р°С†РёСЏ APKW РІ APK"
        Width="820"
        MinWidth="820"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource ForegrounfBrushes}"
        FontFamily="{DynamicResource WinstonRegular}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MainWindowProgram;component/Windows/ConversionDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Border Style="{StaticResource ConversionDialogShellBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource ConversionDialogHeaderBorderStyle}"
                        PreviewMouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="22,0,18,0"
                                   Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                                   Style="{StaticResource ConversionDialogTitleTextStyle}" />

                        <Button Grid.Column="1"
                                Margin="0,0,2,0"
                                Style="{StaticResource ConversionDialogWindowButtonStyle}"
                                ToolTip="Р—Р°РєСЂС‹С‚СЊ РѕРєРЅРѕ"
                                PreviewMouseDown="CloseButton_PreviewMouseDown">
                            <askUiIcons:WindowCloseIcon Size="14"
                                IsHovering="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,18"
                               Text="Р’С‹Р±РµСЂРёС‚Рµ РЅРѕРІС‹Р№ Р°СЂС…РёРІ APKW Рё РїР°РїРєСѓ, РєСѓРґР° РЅСѓР¶РЅРѕ СЃРѕС…СЂР°РЅРёС‚СЊ legacy-РєРѕРјРїР»РµРєС‚ APK + OPK РґР»СЏ СЃС‚Р°СЂРѕР№ РїСЂРѕРіСЂР°РјРјС‹."
                               Style="{StaticResource ConversionDialogDescriptionTextStyle}" />

                    <Border Grid.Row="1"
                            Style="{StaticResource ConversionDialogSectionCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,12"
                                       Text="РСЃС…РѕРґРЅС‹Р№ Р°СЂС…РёРІ APKW"
                                       Style="{StaticResource ConversionDialogSectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="InputFileTextBox"
                                         Grid.Column="0"
                                         Style="{StaticResource ConversionDialogTextBoxStyle}"
                                         TextChanged="InputFileTextBox_TextChanged"
                                         MouseDoubleClick="InputFileTextBox_MouseDoubleClick" />

                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Content="Р’С‹Р±СЂР°С‚СЊ С„Р°Р№Р»"
                                        Style="{StaticResource ConversionDialogBrowseButtonStyle}"
                                        Click="SelectInputFileButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource ConversionDialogSectionCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,12"
                                       Text="РџР°РїРєР° РґР»СЏ СЃРѕС…СЂР°РЅРµРЅРёСЏ APK Рё OPK"
                                       Style="{StaticResource ConversionDialogSectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="OutputDirectoryTextBox"
                                         Grid.Column="0"
                                         Style="{StaticResource ConversionDialogTextBoxStyle}"
                                         TextChanged="OutputDirectoryTextBox_TextChanged"
                                         MouseDoubleClick="OutputDirectoryTextBox_MouseDoubleClick" />

                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Content="Р’С‹Р±СЂР°С‚СЊ РїР°РїРєСѓ"
                                        Style="{StaticResource ConversionDialogBrowseButtonStyle}"
                                        Click="SelectOutputDirectoryButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Style="{StaticResource ConversionDialogHintBorderStyle}">
                        <TextBlock x:Name="StateTextBlock"
                                   Text="Р’С‹Р±РµСЂРёС‚Рµ APKW-Р°СЂС…РёРІ Рё РїР°РїРєСѓ РґР»СЏ СЃРѕС…СЂР°РЅРµРЅРёСЏ."
                                   Style="{StaticResource ConversionDialogHintTextStyle}" />
                    </Border>

                    <Grid Grid.Row="4" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                MinWidth="132"
                                Content="РћС‚РјРµРЅР°"
                                Style="{StaticResource ConversionDialogSecondaryButtonStyle}"
                                IsCancel="True" />
                        <Button x:Name="ConvertButton"
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                Content="РљРѕРЅРІРµСЂС‚РёСЂРѕРІР°С‚СЊ"
                                Style="{StaticResource ConversionDialogPrimaryButtonStyle}"
                                IsDefault="True"
                                Click="ConvertButton_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
