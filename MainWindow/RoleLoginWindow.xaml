<Window x:Class="MainWindowProgram.RoleLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Ask.UI.Shared.Components.Icons;assembly=Ask.UI"
        Title="Вход в АСК-МКИ-М"
        Width="800" Height="600"
        ShowActivated="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White" Foreground="Black">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ask.UI;component/Resources/Assets/Fonts/Font.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="12"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Margin="0" CornerRadius="0,150,150,0" Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#211D36" Offset="0"/>
                        <GradientStop Color="#171B2A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Добро пожаловать!" FontFamily="{StaticResource Manrope}" FontWeight="SemiBold" FontSize="28"
                               Foreground="White" TextAlignment="Center"/>
                    <TextBlock Text="Выберите роль и войдите в систему, чтобы начать работу с АСК-МКИ-М."
                               Margin="0,18,0,0" FontFamily="{StaticResource Manrope}" FontSize="16"
                               Foreground="#ADB4C0" TextAlignment="Center"
                               TextWrapping="Wrap" LineHeight="24" LineStackingStrategy="BlockLineHeight"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>
            <Button x:Name="CancelButton" Grid.Column="1" Focusable="False"
                    ToolTip="Закрыть" AutomationProperties.Name="Закрыть окно входа"
                    Click="CancelButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <icons:WindowCloseIcon Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
        </Grid>
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" Margin="32,0,8,0">
                <StackPanel x:Name="LoginPanel" VerticalAlignment="Center">
                    <TextBlock Text="Роль" Margin="0,0,0,6"/>
                    <ComboBox x:Name="RolesComboBox" Height="32"
                              VerticalContentAlignment="Center" DisplayMemberPath="DisplayText"
                              IsEditable="True" IsReadOnly="True"
                              SelectionChanged="RolesComboBox_SelectionChanged"/>
                    <TextBlock Text="Пароль" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordBox" Height="32" VerticalContentAlignment="Center"
                                     GotFocus="PasswordBox_GotFocus" LostFocus="PasswordBox_LostFocus"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBox x:Name="VisiblePasswordTextBox" Visibility="Collapsed" Height="32"
                                 VerticalContentAlignment="Center" GotFocus="VisiblePasswordTextBox_GotFocus"
                                 LostFocus="VisiblePasswordTextBox_LostFocus" TextChanged="VisiblePasswordTextBox_TextChanged"/>
                        <TextBlock x:Name="PasswordPlaceholderTextBlock" Text="Введите пароль" Margin="8,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/>
                        <Button x:Name="TogglePasswordVisibilityButton" Grid.Column="1" Margin="4,0,0,0"
                                FontFamily="Segoe MDL2 Assets" Click="TogglePasswordVisibilityButton_Click"/>
                        <Button x:Name="KeyboardLayoutButton" Grid.Column="2" Margin="4,0,0,0"
                                Click="KeyboardLayoutButton_Click">
                            <TextBlock x:Name="KeyboardLayoutTextBlock"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="CapsLockWarningTextBlock" Text="Включён Caps Lock"
                               Visibility="Collapsed" Margin="0,6,0,0"/>
                    <Button x:Name="LoginButton" Content="Войти" Height="38" Margin="0,20,0,0"
                            IsEnabled="False" IsDefault="True" Click="LoginButton_Click"/>
                    <TextBlock x:Name="StatusTextBlock" Margin="0,12,0,0" MinHeight="36" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Загрузка приложения" FontSize="22" Margin="0,0,0,20"/>
                    <ProgressBar Height="12" IsIndeterminate="True"/>
                    <TextBlock x:Name="LoadingStatusTextBlock" Margin="0,16,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
