<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:askUiIcons="clr-namespace:Ask.UI.Shared.Components.Icons;assembly=Ask.UI"
    xmlns:mwt="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Classic"
    xmlns:common="clr-namespace:UI.Windows.WpfDocking.Windows"
    xmlns:docking="clr-namespace:UI.Windows.WpfDocking.Windows.Docking"
    xmlns:primitives="clr-namespace:UI.Windows.WpfDocking.Windows.Docking.Primitives">

    <Style x:Key="FloatingWindowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource ActiveForegroundSolidColorBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type primitives:NativeFloatingWindow}">
        <Setter Property="Left" Value="{Binding Path=Left, Mode=TwoWay}" />
        <Setter Property="Top" Value="{Binding Path=Top, Mode=TwoWay}" />
        <Setter Property="Width" Value="{Binding Path=Width, Mode=TwoWay}" />
        <Setter Property="Height" Value="{Binding Path=Height, Mode=TwoWay}" />
        <Setter Property="MinWidth" Value="800" />
        <Setter Property="MinHeight" Value="600" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="DoubleClickCommand" Value="{x:Static docking:DockCommands.ToggleFloating}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:NativeFloatingWindow}">
                    <AdornerDecorator>
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="TopPanel" Background="{StaticResource SecondarySolidColorBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="minimizeButton"
                                        Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        Style="{StaticResource FloatingWindowButtonStyle}"
                                        Command="{x:Static SystemCommands.MinimizeWindowCommand}">
                                    <askUiIcons:WindowMinimizeIcon Size="14"
                                                                   IsHovering="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                </Button>

                                <Button x:Name="maximizeButton"
                                        Grid.Column="2"
                                        Width="40"
                                        Height="40"
                                        Style="{StaticResource FloatingWindowButtonStyle}"
                                        Command="{x:Static SystemCommands.MaximizeWindowCommand}">
                                    <Grid Width="18" Height="18">
                                        <askUiIcons:WindowMaximizeIcon Size="14"
                                                                       IsHovering="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                            <askUiIcons:WindowMaximizeIcon.Style>
                                                <Style TargetType="{x:Type askUiIcons:WindowMaximizeIcon}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=primitives:NativeFloatingWindow}, Path=WindowState}" Value="Maximized">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </askUiIcons:WindowMaximizeIcon.Style>
                                        </askUiIcons:WindowMaximizeIcon>
                                        <askUiIcons:WindowRestoreIcon Size="14"
                                                                      IsHovering="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                                                                      Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                            <askUiIcons:WindowRestoreIcon.Style>
                                                <Style TargetType="{x:Type askUiIcons:WindowRestoreIcon}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=primitives:NativeFloatingWindow}, Path=WindowState}" Value="Maximized">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </askUiIcons:WindowRestoreIcon.Style>
                                        </askUiIcons:WindowRestoreIcon>
                                    </Grid>
                                </Button>

                                <Button x:Name="exitButton"
                                        Grid.Column="3"
                                        Width="40"
                                        Height="40"
                                        Style="{StaticResource FloatingWindowButtonStyle}"
                                        Command="{x:Static SystemCommands.CloseWindowCommand}">
                                    <askUiIcons:WindowCloseIcon Size="14"
                                                                IsHovering="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                </Button>

                                <Border x:Name="PART_DragThumb"
                                        Grid.Column="0"
                                        Background="{StaticResource SecondarySolidColorBrush}"
                                        primitives:DockManager.CanDrag="True" />
                            </Grid>

                            <ContentPresenter Content="{Binding DockTree}" Grid.Row="1"/>
                        </Grid>
                    </AdornerDecorator>

                    <ControlTemplate.Triggers>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding CountOfVisiblePanes}" Value="1">
                <Setter Property="Title" Value="{Binding FirstVisiblePane.SelectedItem.Title}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
