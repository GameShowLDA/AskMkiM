<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:docking="clr-namespace:UI.Windows.WpfDocking.Windows.Docking"
                    xmlns:primitives="clr-namespace:UI.Windows.WpfDocking.Windows.Docking.Primitives">

    <Style TargetType="{x:Type primitives:WindowSwitcher}">
        <Style.Resources>
            <Style x:Key="FileButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource ModernDataGridTextPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="surface" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <TextBlock Text="{Binding TabText}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="surface" Property="Background" Value="{DynamicResource ModernDataGridRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="surface" Property="Background" Value="{DynamicResource WindowSwitcherSelectionBrush}" />
                                    <Setter TargetName="surface" Property="BorderBrush" Value="{DynamicResource ModernDataGridAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="surface" Property="Background" Value="{DynamicResource ModernDataGridRowSelectedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="surface" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ListBox">
                <Setter Property="FocusManager.IsFocusScope" Value="False" />
                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="ItemTemplate" DataType="{x:Type docking:DockItem}">
                <Button Style="{StaticResource FileButtonStyle}" Content="{Binding TabText}"
                        ToolTip="{Binding TabText}" CommandTarget="{Binding}" Command="docking:DockCommands.Show" />
            </DataTemplate>
        </Style.Resources>

        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusManager.IsFocusScope" Value="True" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Cycle" />
        <Setter Property="FontFamily" Value="{DynamicResource WinstonRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ModernDataGridTextPrimaryBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:WindowSwitcher}">
                    <Border Margin="18" Width="520" Height="390" CornerRadius="12"
                            BorderThickness="1" BorderBrush="{DynamicResource WindowSwitcherRimBrush}"
                            Background="{DynamicResource WindowSwitcherSurfaceBrush}"
                            DataContext="{TemplateBinding FocusManager.FocusedElement}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.32" />
                        </Border.Effect>
                        <Grid DataContext="{Binding DataContext}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border CornerRadius="11,11,0,0" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource WindowSwitcherRimBrush}">
                                <Grid>
                                    <Border CornerRadius="11,11,0,0" Opacity="0.18"
                                            Background="{DynamicResource WindowSwitcherSelectionBrush}" />
                                    <Grid Margin="22,0,16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Width="17" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                                              Stroke="{DynamicResource ModernDataGridTextPrimaryBrush}" StrokeThickness="1.2"
                                              StrokeLineJoin="Round" Data="M 1,1 H 10 L 17,8 V 21 H 1 Z M 10,1 V 8 H 17" />
                                        <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                                                   FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding TabText}" />

                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="18,20,18,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="33" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="files" ItemTemplate="{StaticResource ItemTemplate}"
                                             ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActiveDocuments}" />
                                    <TextBlock x:Name="toolsLabel" Grid.Row="1" Text="Окна"
                                               Margin="12,12,0,5" FontSize="11"
                                               Foreground="{DynamicResource ModernDataGridTextSecondaryBrush}" />
                                    <ListBox x:Name="tools" Grid.Row="2" MaxHeight="110"
                                             ItemTemplate="{StaticResource ItemTemplate}"
                                             ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActiveToolWindows}" />
                                </Grid>
                                <Border Grid.Column="1" Width="1" Background="{DynamicResource ModernDataGridBorderBrush}" />
                                <Border Grid.Column="2" Margin="0,20,0,0" Height="238" VerticalAlignment="Top"
                                        CornerRadius="8" Padding="8" BorderThickness="1"
                                        BorderBrush="{DynamicResource WindowSwitcherRimBrush}"
                                        Background="{DynamicResource WindowSwitcherPreviewBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.2" />
                                    </Border.Effect>
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <VisualBrush Visual="{Binding}" AlignmentX="Left" AlignmentY="Top"
                                                         Viewbox="0,0,320,300" ViewboxUnits="Absolute"
                                                         TileMode="None" Stretch="UniformToFill" AutoLayoutContent="False" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="tools" Property="HasItems" Value="False">
                            <Setter TargetName="tools" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="toolsLabel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
