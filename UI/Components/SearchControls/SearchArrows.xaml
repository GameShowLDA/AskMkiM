<UserControl x:Class="UI.Components.SearchControls.SearchArrows"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <DataTemplate x:Key="ActionIcon">
   <Path Data="{Binding GeometryData}" Width="20" Height="20" StrokeThickness="2" Fill="Transparent"
    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
  </DataTemplate>
  <DataTemplate x:Key="ActionItem">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Path Data="{Binding GeometryData}" Width="20" Height="20" StrokeThickness="2" Fill="Transparent"
     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
    <TextBlock Grid.Column="1" Text="{Binding Caption}" Margin="6,0,8,0" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="{Binding Gesture}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate>
  <Style x:Key="ActionItemStyle" TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
   <Setter Property="FontFamily" Value="{DynamicResource WinstonRegular}"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="ToolTip" Value="{Binding Description}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Margin" Value="4,2"/>
   <Setter Property="MinHeight" Value="40"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="Surface" CornerRadius="6" Background="Transparent">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
       <Border x:Name="Indicator" Width="3" HorizontalAlignment="Left" CornerRadius="2" Visibility="Collapsed" Background="{DynamicResource SearchAccentBrush}"/>
       <ContentPresenter Margin="10,8,4,8" VerticalAlignment="Center"/>
       <Path x:Name="Check" Grid.Column="1" Data="M 1,7 L 5,11 L 13,1" Width="14" Height="12" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Visibility="Collapsed"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/></Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
       <Setter Property="Foreground" Value="{DynamicResource SearchAccentBrush}"/>
       <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
       <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Background="Transparent">
  <ComboBox x:Name="searchArrowsComboBox" Width="45" Height="20" SelectedIndex="0"
   Foreground="{DynamicResource ForegrounfBrushes}" Background="Transparent" BorderThickness="0"
   ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}"
   ItemTemplate="{StaticResource ActionItem}" ItemContainerStyle="{StaticResource ActionItemStyle}">
   <ComboBox.Template><ControlTemplate TargetType="ComboBox">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="19"/></Grid.ColumnDefinitions>
     <Border Background="Transparent" Cursor="Hand">
      <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding SelectedItem}"
       ContentTemplate="{StaticResource ActionIcon}" Margin="3,0" VerticalAlignment="Center"
       PreviewMouseDown="PART_ContentPresenter_PreviewMouseDown"/>
     </Border>
     <ToggleButton Grid.Column="1" Focusable="False" Cursor="Hand" Foreground="{TemplateBinding Foreground}"
      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border Background="Transparent"><Path Data="M 0,0 L 8,0 L 4,5 Z" Width="8" Height="5" Fill="{TemplateBinding Foreground}"/></Border>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-265" Width="310" AllowsTransparency="True"
      IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Slide">
      <Border Margin="0,5,0,0" Padding="3" CornerRadius="8" BorderThickness="1"
       Background="{DynamicResource SettingCardBackground}" BorderBrush="{DynamicResource ModernDataGridBorderBrush}">
       <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" MaxHeight="240">
        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
       </ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource SearchAccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></ComboBox.Template>
  </ComboBox>
 </Grid>
</UserControl>
