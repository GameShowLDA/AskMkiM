<UserControl x:Class="UI.Components.TimeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Components"
             FontFamily="{DynamicResource WinstonMedium}"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="80" >
    <Grid>
        <TextBlock
            x:Name="ClockGhost"
            Text=""
            Opacity="0"
            IsHitTestVisible="False"
            FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <TextBlock
            Text="00:00:00"
            FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Name ="Clock"/>
    </Grid>

</UserControl>
