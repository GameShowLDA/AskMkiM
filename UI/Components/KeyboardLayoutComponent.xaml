<UserControl x:Class="UI.Components.KeyboardLayoutComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32" Width="44">
    <Button x:Name="LayoutButton"
            Style="{DynamicResource WindowActionButtonStyle}"
            Height="32" Width="44" Margin="0"
            FontFamily="{DynamicResource Manrope}" FontSize="13" FontWeight="SemiBold"
            ToolTip="Раскладка клавиатуры. Нажмите, чтобы переключить язык."
            AutomationProperties.Name="Переключить раскладку клавиатуры"
            Click="LayoutButton_Click">
        <TextBlock x:Name="LayoutText"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
    </Button>
</UserControl>
