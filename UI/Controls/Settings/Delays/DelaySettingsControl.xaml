<UserControl x:Class="UI.Controls.Settings.Delays.DelaySettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Icons="clr-namespace:UI.Icon"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="DelayTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsHeaderSolidColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsSliderBackgroundSolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsSliderBorderSolidColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0,44,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SettingsInteractiveHoverSolidColorBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Margin="15,10"
            Style="{DynamicResource SettingPanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Padding="10"
                           Text="Задержки оборудования"
                           Style="{DynamicResource SettingsTitleStyle}"/>

                <Grid Grid.Column="1"
                      Margin="20,0"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Icons:ArrowButton x:Name="ToggleSettingsButton"
                                       Grid.Column="0"
                                       Width="30"
                                       Height="30"
                                       VerticalAlignment="Center"
                                       ButtonBackground="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                       ButtonBorder="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                       ArrowBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                       ArrowHoverBrush="{DynamicResource SettingsInteractivePressedSolidColorBrush}"/>

                    <Icons:SuccessIconControlV2 x:Name="SaveIcon"
                                                Grid.Column="1"
                                                Width="30"
                                                Height="30"
                                                Margin="10,0,0,0"
                                                CheckThickness="4"
                                                ToolTip="Сохранить"
                                                Visibility="Collapsed"
                                                CircleBackground="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                                CircleBorder="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                                PreviewMouseDown="SaveIcon_PreviewMouseDown"/>
                    <Icons:ErrorIconControlV2 x:Name="CancelIcon"
                                              Grid.Column="2"
                                              Width="30"
                                              Height="30"
                                              Margin="10,0,0,0"
                                              CrossThickness="4"
                                              ToolTip="Отменить изменения"
                                              Visibility="Collapsed"
                                              CircleBackground="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                              CircleBorder="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                              PreviewMouseDown="CancelIcon_PreviewMouseDown"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ToggleSettingsButton, Path=IsArrowUp}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Margin="15,0,15,4"
                           Text="Значения задаются в миллисекундах. Нулевая задержка отключает ожидание и вывод сообщения."
                           Style="{DynamicResource SettingsDescriptionStyle}"/>

                <WrapPanel Orientation="Horizontal">
                    <Border Width="300"
                            Margin="10"
                            Padding="10"
                            Style="{DynamicResource SettingCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="ППУ — после испытания"
                                       Style="{DynamicResource SettingsHeaderStyle}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Grid.Row="1"
                                       Text="Задержка после завершения испытания напряжения на ППУ."
                                       MinHeight="32"
                                       Style="{DynamicResource SettingsDescriptionStyle}"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBox x:Name="BreakdownPostTestDelayTextBox"
                                         Style="{StaticResource DelayTextBoxStyle}"
                                         PreviewTextInput="DelayTextBox_PreviewTextInput"
                                         TextChanged="DelayTextBox_TextChanged"
                                         DataObject.Pasting="DelayTextBox_Pasting"/>
                                <TextBlock Margin="0,0,14,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="мс"
                                           Style="{DynamicResource SettingsDescriptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Width="300"
                            Margin="10"
                            Padding="10"
                            Style="{DynamicResource SettingCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="МКР — перед командой"
                                       Style="{DynamicResource SettingsHeaderStyle}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Grid.Row="1"
                                       Text="Задержка перед отправкой команды в модуль коммутации реле."
                                       MinHeight="32"
                                       Style="{DynamicResource SettingsDescriptionStyle}"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBox x:Name="ModulePreCommandDelayTextBox"
                                         Style="{StaticResource DelayTextBoxStyle}"
                                         PreviewTextInput="DelayTextBox_PreviewTextInput"
                                         TextChanged="DelayTextBox_TextChanged"
                                         DataObject.Pasting="DelayTextBox_Pasting"/>
                                <TextBlock Margin="0,0,14,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="мс"
                                           Style="{DynamicResource SettingsDescriptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Width="300"
                            Margin="10"
                            Padding="10"
                            Style="{DynamicResource SettingCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="МКР — после команды"
                                       Style="{DynamicResource SettingsHeaderStyle}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Grid.Row="1"
                                       Text="Задержка после отправки команды в модуль коммутации реле."
                                       MinHeight="32"
                                       Style="{DynamicResource SettingsDescriptionStyle}"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBox x:Name="ModulePostCommandDelayTextBox"
                                         Style="{StaticResource DelayTextBoxStyle}"
                                         PreviewTextInput="DelayTextBox_PreviewTextInput"
                                         TextChanged="DelayTextBox_TextChanged"
                                         DataObject.Pasting="DelayTextBox_Pasting"/>
                                <TextBlock Margin="0,0,14,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="мс"
                                           Style="{DynamicResource SettingsDescriptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
