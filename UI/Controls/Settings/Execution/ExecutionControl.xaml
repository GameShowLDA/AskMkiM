<UserControl x:Class="UI.Controls.Settings.Execution.ExecutionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Controls.Settings.Execution"
             xmlns:Components ="clr-namespace:UI.Components"
             xmlns:SharedComponents="clr-namespace:Ask.UI.Shared.Components;assembly=Ask.UI"
             xmlns:Icons="clr-namespace:UI.Icon"
             xmlns:LocalizeStrings="clr-namespace:Ask.UI.Infrastructure.Localization;assembly=Ask.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_Section_Title" Key="settings.execution.section.title" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_StopOnError_Title" Key="settings.execution.stopOnError.title" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_StopOnError_Description" Key="settings.execution.stopOnError.description" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_RepeatMeasurement_Title" Key="settings.execution.repeatMeasurement.title" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_RepeatMeasurement_Description" Key="settings.execution.repeatMeasurement.description" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_StepByStepMode_Title" Key="settings.execution.stepByStepMode.title" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_StepByStepMode_Description" Key="settings.execution.stepByStepMode.description" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_IdleMode_Title" Key="settings.execution.idleMode.title" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_IdleMode_Description" Key="settings.execution.idleMode.description" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_ErrorSimulation_Title" Key="settings.execution.errorSimulation.title" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_ErrorSimulation_Description" Key="settings.execution.errorSimulation.description" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_MeasurementErrorSimulation_Title" Key="settings.execution.measurementErrorSimulation.title" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_MeasurementErrorSimulation_Description" Key="settings.execution.measurementErrorSimulation.description" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_HardwareErrorSimulation_Title" Key="settings.execution.hardwareErrorSimulation.title" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_HardwareErrorSimulation_Description" Key="settings.execution.hardwareErrorSimulation.description" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_DisablePowerCheck_Title" Key="settings.execution.disablePowerCheck.title" />
        <LocalizeStrings:LocalizedString x:Key="Settings_Execution_DisablePowerCheck_Description" Key="settings.execution.disablePowerCheck.description" />
    </UserControl.Resources>

    <Border 
        Margin="15,10" 
        Style="{DynamicResource SettingPanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBlock 
                    Text="{Binding Source={StaticResource Settings_Execution_Section_Title}, Path=Value}" 
                    Padding="10,10"
                    Style="{DynamicResource SettingsTitleStyle}"
                    Grid.Row="0"/>

                <Grid Grid.Column="1"  Margin="20,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Icons:SuccessIconControlV2 
                        Grid.Column="1"
                        x:Name="Success" 
                        Width="30"
                        Margin="10,0,0,0"
                        Height="30" 
                        CheckThickness="4"
                        CircleBackground ="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                        CircleBorder="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                        />

                    <Icons:ErrorIconControlV2 
                         x:Name="Error"
                           Grid.Column="2"
                         Width="30"
                         Height="30" 
                           Margin="10,0,0,0"
                           CrossThickness="4"
                         CircleBackground ="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                         CircleBorder="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                         />

                    <Icons:ArrowButton x:Name="ToggleSettingsButton" 
                           Grid.Column="0"
                           HorizontalAlignment="Right"
                           Width="30" Height="30"
                           ButtonBackground="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                           ButtonBorder="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                           ArrowBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                           ArrowHoverBrush="{DynamicResource SettingsInteractivePressedSolidColorBrush}"
                           VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ToggleSettingsButton, Path=IsArrowUp}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <WrapPanel Orientation="Horizontal">

                <SharedComponents:SettingsCard
                    Title="{Binding Source={StaticResource Settings_Execution_StopOnError_Title}, Path=Value}"
                    Description="{Binding Source={StaticResource Settings_Execution_StopOnError_Description}, Path=Value}"
                    IsChecked="{Binding IdleMode, Mode=TwoWay}" 
                    Margin="10,10"
                    VerticalAlignment="Top"
                    x:Name="StopInError"
                 />

                <SharedComponents:SettingsCard
                    Title="{Binding Source={StaticResource Settings_Execution_RepeatMeasurement_Title}, Path=Value}"
                    Description="{Binding Source={StaticResource Settings_Execution_RepeatMeasurement_Description}, Path=Value}"
                    Margin="10,10"
                    VerticalAlignment="Top"
                    x:Name="RepeatMeasurement"
                 />

                <SharedComponents:SettingsCard
                     Title="{Binding Source={StaticResource Settings_Execution_StepByStepMode_Title}, Path=Value}"
                     Description="{Binding Source={StaticResource Settings_Execution_StepByStepMode_Description}, Path=Value}"
                     IsChecked="{Binding IdleMode, Mode=TwoWay}" 
                     Margin="10,10"
                     VerticalAlignment="Top"
                    x:Name="StepByStepMode"
                     />

                <SharedComponents:SettingsCard 
                    Title="{Binding Source={StaticResource Settings_Execution_IdleMode_Title}, Path=Value}" 
                    Description="{Binding Source={StaticResource Settings_Execution_IdleMode_Description}, Path=Value}"
                    IsChecked="{Binding IdleMode, Mode=TwoWay}" 
                    Margin="10,10"
                    VerticalAlignment="Top"
                    x:Name="IdleMode"
                    />

                <SharedComponents:SettingsCard
                    Title="{Binding Source={StaticResource Settings_Execution_CompatibilityMode}, Path=Value}"
                    Description="{Binding Source={StaticResource Settings_Execution_CompatibilityMode_LegacySystemExecution}, Path=Value}"
                    IsChecked="{Binding IdleMode, Mode=TwoWay}" 
                    Margin="10,10"
                    VerticalAlignment="Top"
                    x:Name="CompatibilityModeCheckBox"
                 />
                </WrapPanel>

                <WrapPanel x:Name="RootSettingsGroup"
                           Orientation="Horizontal"
                           Visibility="Collapsed">
                    <SharedComponents:SettingsCard
                        Title="{Binding Source={StaticResource Settings_Execution_DisablePowerCheck_Title}, Path=Value}"
                        Description="{Binding Source={StaticResource Settings_Execution_DisablePowerCheck_Description}, Path=Value}"
                        Margin="10,10"
                        VerticalAlignment="Top"
                        x:Name="DisablePowerCheck" />
                </WrapPanel>

                <Border x:Name="ErrorSimulationGroup"
                        Margin="10,4,10,10"
                        Padding="16"
                        Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SettingCardStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=IdleMode, Path=IsChecked}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={StaticResource Settings_Execution_ErrorSimulation_Title}, Path=Value}"
                                           Style="{DynamicResource SettingsTitleStyle}"/>
                                <TextBlock Text="{Binding Source={StaticResource Settings_Execution_ErrorSimulation_Description}, Path=Value}"
                                           Margin="0,2,0,0"
                                           Style="{DynamicResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Components:SettingsCardSelect
                                Grid.Column="0"
                                Title="{Binding Source={StaticResource Settings_Execution_MeasurementErrorSimulation_Title}, Path=Value}"
                                Description="{Binding Source={StaticResource Settings_Execution_MeasurementErrorSimulation_Description}, Path=Value}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                DisplayMemberPath="Title"
                                SelectedValuePath="Value"
                                x:Name="ErroneousMeasurementTypeSelect"/>

                            <Border Grid.Column="2"
                                    Padding="12,10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Style="{DynamicResource SettingCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Source={StaticResource Settings_Execution_HardwareErrorSimulation_Title}, Path=Value}"
                                                       Style="{DynamicResource SettingsHeaderStyle}"/>
                                            <TextBlock Text="{Binding Source={StaticResource Settings_Execution_HardwareErrorSimulation_Description}, Path=Value}"
                                                       Margin="0,2,0,0"
                                                       Style="{DynamicResource SettingsDescriptionStyle}"/>
                                        </StackPanel>

                                        <Icons:ArrowButton x:Name="ToggleHardwareErrorSimulationButton"
                                                           Grid.Column="1"
                                                           Width="30"
                                                           Height="30"
                                                           ButtonBackground="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                                           ButtonBorder="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                                           ArrowBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                                           ArrowHoverBrush="{DynamicResource SettingsInteractivePressedSolidColorBrush}"
                                                           VerticalAlignment="Center"/>
                                    </Grid>

                                    <WrapPanel x:Name="HardwareErrorSimulationCards"
                                               Grid.Row="1"
                                               Margin="0,8,0,0"
                                               Orientation="Horizontal">
                                        <WrapPanel.Style>
                                            <Style TargetType="WrapPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ToggleHardwareErrorSimulationButton, Path=IsArrowUp}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </WrapPanel.Style>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
