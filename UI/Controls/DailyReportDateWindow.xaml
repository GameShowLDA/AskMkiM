<Window x:Class="UI.Controls.DailyReportDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:calendar="clr-namespace:UI.Controls.Calendar"
        xmlns:icons="clr-namespace:Ask.UI.Shared.Components.Icons;assembly=Ask.UI"
        Title="Отчёт за день" Width="470" Height="390"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" Foreground="{DynamicResource ForegrounfBrushes}"
        FontFamily="{DynamicResource WinstonLight}">
  <Border Margin="24" CornerRadius="22" BorderThickness="1"
          BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
          Background="{DynamicResource SecondarySolidColorBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.4" Color="#A0000000"/>
    </Border.Effect>
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="82"/>
      </Grid.RowDefinitions>
      <Border CornerRadius="21,21,0,0"
              Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
              PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="24,0,16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="42" Height="42" CornerRadius="12"
                  Background="{DynamicResource ActiveBorderSolidColorBrush}">
            <icons:DailyReportIcon Size="20" Foreground="{DynamicResource SecondarySolidColorBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock FontFamily="{DynamicResource WinstonBold}" FontSize="22"
                       Foreground="{DynamicResource MainTitleSolidColorBrush}" Text="Отчёт за день"/>
            <TextBlock Margin="0,3,0,0" FontSize="12"
                       Foreground="{DynamicResource ForegroundSolidColorBrush60}"
                       Text="Диагностический архив приложения"/>
          </StackPanel>
          <Button Grid.Column="2" Width="38" Height="38" Padding="0" FontSize="20"
                  Style="{DynamicResource ButtonStyleV13}" IsCancel="True" Content="×"/>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="24,22,24,0">
        <TextBlock FontFamily="{DynamicResource WinstonBold}" FontSize="15"
                   Foreground="{DynamicResource MainTitleSolidColorBrush}" Text="Дата отчёта"/>
        <Border x:Name="DateField" Margin="0,10,0,0" Height="48" CornerRadius="12"
                BorderThickness="1" BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                Cursor="Hand" MouseLeftButtonUp="CalendarButton_Click">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedDateText" Margin="14,0,8,0" VerticalAlignment="Center"
                       FontFamily="{DynamicResource WinstonMedium}" FontSize="14"
                       Foreground="{DynamicResource ForegrounfBrushes}"/>
            <icons:CalendarIcon Grid.Column="1" Size="16"
                                Foreground="{DynamicResource ForegrounfBrushes85}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Popup x:Name="CalendarPopup" Grid.ColumnSpan="2" Placement="Bottom"
                   PlacementTarget="{Binding ElementName=DateField}" VerticalOffset="4"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
              <calendar:CalendarControl x:Name="ReportCalendar"
                                        SelectedDateChanged="ReportCalendar_SelectedDateChanged"/>
            </Popup>
          </Grid>
        </Border>
        <StackPanel Margin="2,10,2,0" Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="#51C878" VerticalAlignment="Center"/>
          <TextBlock Margin="5,0,14,0" FontSize="11" Foreground="{DynamicResource ForegroundSolidColorBrush60}"
                     Text="Протоколы и логи"/>
          <Ellipse Width="7" Height="7" Fill="#F2B84B" VerticalAlignment="Center"/>
          <TextBlock Margin="5,0,14,0" FontSize="11" Foreground="{DynamicResource ForegroundSolidColorBrush60}"
                     Text="Часть данных"/>
          <Ellipse Width="7" Height="7" Fill="{DynamicResource ForegrounfBrushes35}" VerticalAlignment="Center"/>
          <TextBlock Margin="5,0,0,0" FontSize="11" Foreground="{DynamicResource ForegroundSolidColorBrush60}"
                     Text="Нет данных"/>
        </StackPanel>
        <TextBlock Margin="2,10,2,0" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                   Foreground="{DynamicResource ForegroundSolidColorBrush60}"
                   Text="В архив войдут протоколы, журналы приложения и отчёты о сбоях за выбранную дату."/>
      </StackPanel>
      <Grid Grid.Row="2" Margin="24,16,24,18">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Width="105" Height="44" Margin="0,0,10,0" Padding="12,7" FontSize="15"
                  Style="{DynamicResource ButtonStyleV13}" IsCancel="True" Content="Отмена"/>
          <Button Width="150" Height="44" Padding="12,7" FontSize="15"
                  Style="{DynamicResource ButtonStyleV10}" IsDefault="True"
                  Click="Save_Click" Content="Сохранить ZIP"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
