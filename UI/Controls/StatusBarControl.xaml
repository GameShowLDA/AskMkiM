<UserControl x:Class="UI.Controls.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Manrope}" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="EncodingButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{DynamicResource Manrope}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrushes}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.16"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.22"/>
                                        <VisualTransition To="Disabled" GeneratedDuration="0"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.025" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.025" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBevel"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RaisedShadows"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="InsetShading"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBevel"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RaisedShadows"
                                                             Storyboard.TargetProperty="Opacity" To="0.2" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="RaisedShadows" IsHitTestVisible="False">
                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{Binding Foreground.Color, RelativeSource={RelativeSource TemplatedParent}}" Direction="135" BlurRadius="8"
                                                          ShadowDepth="2" Opacity="{DynamicResource TopPanelButtonHighlightOpacity}"/>
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="315" BlurRadius="8"
                                                          ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <Border x:Name="ButtonSurface" CornerRadius="8"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="ButtonBevel" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource TopPanelButtonBevelBrush}"
                                    Opacity="0.65" IsHitTestVisible="False"/>
                            <Grid x:Name="InsetShading" Opacity="0" IsHitTestVisible="False">
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#80000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.32"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.68"/>
                                            <GradientStop Color="#20FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#50000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.06"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.94"/>
                                            <GradientStop Color="#16FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ForegrounfBrushes35}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style x:Key="StatusMetricStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes45}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
        <Border Style="{StaticResource StatusSeparatorStyle}" Margin="0,0,14,0"/>
        <TextBlock x:Name="LineText" Style="{StaticResource StatusMetricStyle}" ToolTip="Текущая строка курсора">
            <Run Text="Строка: "/><Run Text="{Binding Line}" Foreground="{DynamicResource MainTitleSolidColorBrush}" FontWeight="SemiBold"/>
        </TextBlock>
        <Border Style="{StaticResource StatusSeparatorStyle}"/>
        <TextBlock x:Name="ColumnText" Style="{StaticResource StatusMetricStyle}" ToolTip="Текущий столбец курсора">
            <Run Text="Столбец: "/><Run Text="{Binding Column}" Foreground="{DynamicResource MainTitleSolidColorBrush}" FontWeight="SemiBold"/>
        </TextBlock>
        <Border Style="{StaticResource StatusSeparatorStyle}"/>
        <TextBlock x:Name="LineCountText" Style="{StaticResource StatusMetricStyle}" ToolTip="Количество строк в документе">
            <Run Text="Всего строк: "/><Run Text="{Binding LineCount}" Foreground="{DynamicResource MainTitleSolidColorBrush}" FontWeight="SemiBold"/>
        </TextBlock>
        <Border Style="{StaticResource StatusSeparatorStyle}"/>
        <Button x:Name="EncodingButton" Style="{StaticResource EncodingButtonStyle}"
                Content="{Binding EncodingName}" Command="{Binding ToggleEncodingCommand}"
                MouseRightButtonUp="EncodingButton_MouseRightButtonUp"
                ToolTip="Кодировка файла. ЛКМ: UTF-8 / DOS. ПКМ: выбрать из списка."
                AutomationProperties.Name="Кодировка открытого файла"/>
    </StackPanel>
</UserControl>
