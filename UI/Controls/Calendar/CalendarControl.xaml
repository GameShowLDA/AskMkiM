<UserControl x:Class="UI.Controls.Calendar.CalendarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Clock="clr-namespace:UI.Components"
             xmlns:calendar="clr-namespace:UI.Controls.Calendar"
             xmlns:icons="clr-namespace:Ask.UI.Shared.Components.Icons;assembly=Ask.UI"
             mc:Ignorable="d"
             d:DesignHeight="440"
             d:DesignWidth="352"
             Width="352" Focusable="True">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/UI;component/Resources/Styles/TaskCompletionStyle.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="NoteInputStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{DynamicResource Manrope}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <Border Margin="1" CornerRadius="9" IsHitTestVisible="False" BorderThickness="1,2,0,0" BorderBrush="{DynamicResource TopPanelHoverBackgroundBrush}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsInteractiveActiveSolidColorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrushes}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="{DynamicResource Manrope}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.16"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.22"/>
                                        <VisualTransition To="Disabled" GeneratedDuration="0"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.025" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.025" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBevel"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RaisedShadows"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="InsetShading"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBevel"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RaisedShadows"
                                                             Storyboard.TargetProperty="Opacity" To="0.2" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="RaisedShadows" IsHitTestVisible="False">
                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{Binding Foreground.Color, RelativeSource={RelativeSource TemplatedParent}}" Direction="135" BlurRadius="8"
                                                          ShadowDepth="2" Opacity="{DynamicResource TopPanelButtonHighlightOpacity}"/>
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="315" BlurRadius="8"
                                                          ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <Border x:Name="ButtonSurface" CornerRadius="8"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="ButtonBevel" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource TopPanelButtonBevelBrush}"
                                    Opacity="0.65" IsHitTestVisible="False"/>
                            <Grid x:Name="InsetShading" Opacity="0" IsHitTestVisible="False">
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#80000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.32"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.68"/>
                                            <GradientStop Color="#20FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#50000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.06"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.94"/>
                                            <GradientStop Color="#16FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarNavButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CalendarActionButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes85}"/>
        </Style>

        <Style x:Key="CalendarWeekdayTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Manrope}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes45}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes85}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource Manrope}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="DayRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.16"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.22"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DayRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="DayRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DayRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="DayRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="DayPressOverlay" Storyboard.TargetProperty="Opacity" To="0.15" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="DaySurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                    <Border x:Name="NoteCountBadge" Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}" CornerRadius="4" MinWidth="12" Height="12" Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding NoteCountCaption}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource ForegrounfBrushes}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Ellipse x:Name="TodayDot"
                                             Width="4"
                                             Height="4"
                                             Fill="{DynamicResource SettingsSelectorSelectedSolidColorBrush}"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,0,6"
                                             Visibility="Collapsed"/>
                                    <Ellipse x:Name="AvailabilityDot"
                                             Width="6"
                                             Height="6"
                                             Fill="{DynamicResource ForegrounfBrushes35}"
                                             VerticalAlignment="Top"
                                             HorizontalAlignment="Right"
                                             Margin="0,5,5,0"
                                             Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Border x:Name="DayPressOverlay" CornerRadius="9" Background="Black" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DaySurface" Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
                                <Setter TargetName="DaySurface" Property="BorderBrush" Value="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MainTitleSolidColorBrush}"/>
                            </Trigger>

                            <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                <Setter TargetName="NoteCountBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes35}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="DaySurface" Property="BorderBrush" Value="{DynamicResource SettingsSelectorSelectedSolidColorBrush}"/>
                                <Setter TargetName="DaySurface" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="TodayDot" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="DaySurface" Property="Background" Value="{DynamicResource SettingsSelectorSelectedSolidColorBrush}"/>
                                <Setter TargetName="DaySurface" Property="BorderBrush" Value="{DynamicResource SettingsSelectorSelectedSolidColorBrush}"/>
                                <Setter TargetName="TodayDot" Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource MainTitleSolidColorBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Availability}" Value="Partial">
                                <Setter TargetName="AvailabilityDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="AvailabilityDot" Property="Fill" Value="#F2B84B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Availability}" Value="Complete">
                                <Setter TargetName="AvailabilityDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="AvailabilityDot" Property="Fill" Value="#51C878"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Availability}" Value="None">
                                <Setter TargetName="AvailabilityDot" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
          </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="CalendarLayout">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="352"/></Grid.ColumnDefinitions>
    <Border x:Name="CalendarSurface" Grid.Column="1" VerticalAlignment="Bottom" Margin="10"
            Padding="16"
            Background="{DynamicResource SettingsPanelBackgroundSolidColorBrush}"
            BorderBrush="{DynamicResource TopPanelHoverBackgroundBrush}"
            BorderThickness="1"
            CornerRadius="16"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="#B3000000"/>
        </Border.Effect>

        <Grid VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Календарь"
                               FontFamily="{DynamicResource Manrope}"
                               FontSize="12"
                               Foreground="{DynamicResource ForegrounfBrushes35}"/>
                    <Clock:TimeControl FontFamily="{DynamicResource Manrope}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegrounfBrushes}"
                                       Margin="0,4,0,0"
                                       FullTime="True"/>
                    <TextBlock Text="{Binding SelectionCaption}"
                               Margin="0,4,0,0"
                               FontFamily="{DynamicResource Manrope}"
                               FontSize="14"
                               Foreground="{DynamicResource ForegrounfBrushes85}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="TodayButton"
                        Style="{StaticResource CalendarActionButtonStyle}"
                        VerticalAlignment="Top"
                        Command="{Binding TodayCommand}"
                        Content="Сегодня"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,18,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PreviousMonthButton" Grid.Column="0"
                            ToolTip="Предыдущий месяц"
                            Style="{StaticResource CalendarNavButtonStyle}"
                            Command="{Binding PrevMonthCommand}">
                        <Path Data="M 15 5 L 8 12 L 15 19"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              Width="10"
                              Height="14"/>
                    </Button>

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding MonthYear}"
                               FontFamily="{DynamicResource Manrope}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTitleSolidColorBrush}"/>

                    <Button x:Name="NextMonthButton" Grid.Column="2"
                            ToolTip="Следующий месяц"
                            Style="{StaticResource CalendarNavButtonStyle}"
                            Command="{Binding NextMonthCommand}">
                        <Path Data="M 9 5 L 16 12 L 9 19"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              Width="10"
                              Height="14"/>
                    </Button>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2"
                         Rows="1"
                         Columns="7"
                         Margin="0,0,0,8">
                <TextBlock Text="Пн" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Вт" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Ср" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Чт" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Пт" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Сб" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Вс" Style="{StaticResource CalendarWeekdayTextStyle}"/>
            </UniformGrid>

            <ItemsControl x:Name="DaysList" Grid.Row="3"
                          ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CalendarDayButtonStyle}"
                                Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{Binding DayNumber}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Border>
    <Border x:Name="NotesSurface" Grid.Column="0" Width="344" MinHeight="180" MaxHeight="534" VerticalAlignment="Bottom" Margin="0,10,8,10" Padding="16" CornerRadius="16" Visibility="Collapsed"
            Background="{DynamicResource SettingsPanelBackgroundSolidColorBrush}" BorderBrush="{DynamicResource TopPanelHoverBackgroundBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.3" Color="#B3000000"/></Border.Effect>
            <StackPanel x:Name="NotesPanel" Width="310" TextElement.FontFamily="{DynamicResource Manrope}">

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="NotesHeading" Text="Заметки дня" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegrounfBrushes}"/>
                        <TextBlock x:Name="NotesCountText" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource ForegrounfBrushes45}"/>
                    </StackPanel>
                    <Button x:Name="AddNoteButton" Grid.Column="1" Margin="0,0,6,0" HorizontalAlignment="Right" Style="{StaticResource CalendarActionButtonStyle}" Content="+ Добавить" Click="AddNote_Click"/>
                    <Button x:Name="CloseNotesButton" Grid.Column="2" Style="{StaticResource CalendarNavButtonStyle}" Content="×" ToolTip="Закрыть заметки" AutomationProperties.Name="Закрыть заметки" Click="CloseNotes_Click"/>
                </Grid>

                <Button x:Name="ReloadNotesButton" Content="Повторить загрузку" Margin="0,8,0,0" Visibility="Collapsed" Style="{StaticResource CalendarActionButtonStyle}" Click="ReloadNotes_Click"/>
                <TextBlock x:Name="EmptyNotesText" Text="На этот день заметок нет" Margin="0,14,0,0" Foreground="{DynamicResource ForegrounfBrushes45}" FontSize="13"/>
                <ScrollViewer x:Name="NotesListScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <ItemsControl x:Name="NotesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10" Margin="0,0,0,6" BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="TaskCompletionBox" Style="{StaticResource TaskCompletionCheckBoxStyle}" IsChecked="{Binding IsCompleted, Mode=OneWay}" Tag="{Binding}" Click="Completion_Click" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Отметить выполнение дела" AutomationProperties.Name="Отметить выполнение дела"/>
                                                <calendar:TaskTitle Grid.Column="1" IsCompleted="{Binding IsChecked, ElementName=TaskCompletionBox}" Text="{Binding Caption}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ForegrounfBrushes}">
                                                    <calendar:TaskTitle.Style><Style TargetType="calendar:TaskTitle"><Style.Triggers><Trigger Property="IsCompleted" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger></Style.Triggers></Style></calendar:TaskTitle.Style>
                                                </calendar:TaskTitle>
                                            </Grid>
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForegrounfBrushes85}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=TaskCompletionBox}" Value="True"><Setter Property="Opacity" Value="0.7"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            </ScrollViewer>
                                        </StackPanel>
                                        <StackPanel x:Name="RowActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource CalendarNavButtonStyle}" Tag="{Binding}" Click="EditListNote_Click" ToolTip="Редактировать заметку" AutomationProperties.Name="Редактировать заметку" Margin="0,0,4,0">
                                                <icons:EditIcon Size="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                            <Button Style="{StaticResource CalendarNavButtonStyle}" Tag="{Binding}" Click="DeleteListNote_Click" ToolTip="Удалить заметку" AutomationProperties.Name="Удалить заметку">
                                                <icons:TrashDeleteIcon Size="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="RowConfirmation" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Button Style="{StaticResource CalendarNavButtonStyle}" Click="ConfirmDelete_Click" Margin="0,0,4,0" ToolTip="Подтвердить удаление" AutomationProperties.Name="Подтвердить удаление">
                                                <Path Width="16" Height="16" Stretch="Uniform" Data="M 2,8 L 6,12 L 14,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Button>
                                            <Button Style="{StaticResource CalendarNavButtonStyle}" Click="CancelDelete_Click" ToolTip="Отменить удаление" AutomationProperties.Name="Отменить удаление">
                                                <Path Width="14" Height="14" Stretch="Uniform" Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="NoteEditor" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="EditorHeading" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegrounfBrushes}"/>
                    <TextBlock Text="Дата" Margin="0,10,0,4" FontSize="12" Foreground="{DynamicResource ForegrounfBrushes85}"/>
                    <DatePicker x:Name="NoteDate" Height="48" FontFamily="{DynamicResource Manrope}" FontSize="13" Foreground="{DynamicResource ForegrounfBrushes}" Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}" BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}" BorderThickness="1">
                        <DatePicker.Template>
                            <ControlTemplate TargetType="DatePicker">
                                <Border x:Name="DateSurface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <Grid Margin="12,0,6,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                        <DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}">
                                            <DatePickerTextBox.Template>
                                                <ControlTemplate TargetType="DatePickerTextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                                                </ControlTemplate>
                                            </DatePickerTextBox.Template>
                                        </DatePickerTextBox>
                                        <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource CalendarNavButtonStyle}" VerticalAlignment="Center" ToolTip="Выбрать дату" AutomationProperties.Name="Выбрать дату">
                                            <icons:CalendarIcon Size="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" VerticalOffset="4" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="DateSurface" Property="BorderBrush" Value="{DynamicResource SettingsInteractiveActiveSolidColorBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </DatePicker.Template>
                    </DatePicker>
                    <TextBlock Text="Заголовок (необязательно)" Margin="0,10,0,4" FontSize="12" Foreground="{DynamicResource ForegrounfBrushes85}"/>
                    <TextBox x:Name="NoteTitle" Height="48" MaxLength="200" Style="{StaticResource NoteInputStyle}"/>
                    <TextBlock Text="Текст заметки" Margin="0,10,0,4" FontSize="12" Foreground="{DynamicResource ForegrounfBrushes85}"/>
                    <TextBox x:Name="NoteText" Height="80" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource NoteInputStyle}"/>
                    <TextBlock x:Name="EditorError" Height="32" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource ForegrounfBrushes85}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="SaveNoteButton" Style="{StaticResource CalendarNavButtonStyle}" Click="SaveNote_Click" Margin="0,0,8,0" ToolTip="Сохранить заметку" AutomationProperties.Name="Сохранить заметку">
                            <Path Width="16" Height="16" Stretch="Uniform" Data="M 2,8 L 6,12 L 14,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="CancelEditButton" Style="{StaticResource CalendarNavButtonStyle}" Click="CancelEdit_Click" ToolTip="Отменить редактирование" AutomationProperties.Name="Отменить редактирование">
                            <Path Width="14" Height="14" Stretch="Uniform" Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <Grid Margin="0,12,0,0" Height="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="NotesStatus" Height="16" VerticalAlignment="Center" Visibility="Collapsed" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource ForegrounfBrushes85}" FontSize="11"/>
                    <TextBlock x:Name="NotesHint" Text="Esc — закрыть" Height="16" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ForegrounfBrushes45}"/>
                    <Button x:Name="UndoDeleteButton" Grid.Column="1" Content="Отменить" Visibility="Collapsed" Height="24" Padding="8,0" Margin="8,0,0,0" FontSize="11" Style="{StaticResource CalendarActionButtonStyle}" ToolTip="Восстановить последнюю удалённую заметку" AutomationProperties.Name="Отменить удаление заметки" Click="UndoDelete_Click"/>
                </Grid>
            </StackPanel>
    </Border>
    </Grid>
</UserControl>
