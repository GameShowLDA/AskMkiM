<UserControl x:Class="UI.Controls.Calendar.CalendarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Clock="clr-namespace:UI.Components"
             mc:Ignorable="d"
             d:DesignHeight="440"
             d:DesignWidth="352"
             Width="352">
    <UserControl.Resources>
        <Style x:Key="NoteInputStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{DynamicResource Manrope}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <Border Margin="1" CornerRadius="9" IsHitTestVisible="False" BorderThickness="1,2,0,0" BorderBrush="{DynamicResource TopPanelHoverBackgroundBrush}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsInteractiveActiveSolidColorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrushes}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="{DynamicResource Manrope}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.16"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.22"/>
                                        <VisualTransition To="Disabled" GeneratedDuration="0"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.025" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.025" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBevel"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RaisedShadows"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="InsetShading"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBevel"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RaisedShadows"
                                                             Storyboard.TargetProperty="Opacity" To="0.2" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="RaisedShadows" IsHitTestVisible="False">
                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{Binding Foreground.Color, RelativeSource={RelativeSource TemplatedParent}}" Direction="135" BlurRadius="8"
                                                          ShadowDepth="2" Opacity="{DynamicResource TopPanelButtonHighlightOpacity}"/>
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="315" BlurRadius="8"
                                                          ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <Border x:Name="ButtonSurface" CornerRadius="8"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="ButtonBevel" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource TopPanelButtonBevelBrush}"
                                    Opacity="0.65" IsHitTestVisible="False"/>
                            <Grid x:Name="InsetShading" Opacity="0" IsHitTestVisible="False">
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#80000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.32"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.68"/>
                                            <GradientStop Color="#20FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#50000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.06"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.94"/>
                                            <GradientStop Color="#16FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarNavButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CalendarActionButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes85}"/>
        </Style>

        <Style x:Key="CalendarWeekdayTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Manrope}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes45}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes85}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource Manrope}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="DayRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.16"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.22"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DayRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="DayRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DayRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="DayRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="DayPressOverlay" Storyboard.TargetProperty="Opacity" To="0.15" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="DaySurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                    <Ellipse x:Name="NoteDot" Width="5" Height="5"
                                             Fill="{DynamicResource ForegrounfBrushes85}"
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Margin="5" Visibility="Collapsed"/>
                                    <Ellipse x:Name="TodayDot"
                                             Width="4"
                                             Height="4"
                                             Fill="{DynamicResource SettingsSelectorSelectedSolidColorBrush}"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,0,6"
                                             Visibility="Collapsed"/>
                                    <Ellipse x:Name="AvailabilityDot"
                                             Width="6"
                                             Height="6"
                                             Fill="{DynamicResource ForegrounfBrushes35}"
                                             VerticalAlignment="Top"
                                             HorizontalAlignment="Right"
                                             Margin="0,5,5,0"
                                             Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Border x:Name="DayPressOverlay" CornerRadius="9" Background="Black" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DaySurface" Property="Background" Value="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"/>
                                <Setter TargetName="DaySurface" Property="BorderBrush" Value="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MainTitleSolidColorBrush}"/>
                            </Trigger>

                            <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                <Setter TargetName="NoteDot" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes35}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="DaySurface" Property="BorderBrush" Value="{DynamicResource SettingsSelectorSelectedSolidColorBrush}"/>
                                <Setter TargetName="DaySurface" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="TodayDot" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="DaySurface" Property="Background" Value="{DynamicResource SettingsSelectorSelectedSolidColorBrush}"/>
                                <Setter TargetName="DaySurface" Property="BorderBrush" Value="{DynamicResource SettingsSelectorSelectedSolidColorBrush}"/>
                                <Setter TargetName="TodayDot" Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource MainTitleSolidColorBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Availability}" Value="Partial">
                                <Setter TargetName="AvailabilityDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="AvailabilityDot" Property="Fill" Value="#F2B84B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Availability}" Value="Complete">
                                <Setter TargetName="AvailabilityDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="AvailabilityDot" Property="Fill" Value="#51C878"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Availability}" Value="None">
                                <Setter TargetName="AvailabilityDot" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Margin="10"
            Padding="16"
            Background="{DynamicResource SettingsPanelBackgroundSolidColorBrush}"
            BorderBrush="{DynamicResource TopPanelHoverBackgroundBrush}"
            BorderThickness="1"
            CornerRadius="16"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="#B3000000"/>
        </Border.Effect>

        <ScrollViewer MaxHeight="650" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Календарь"
                               FontFamily="{DynamicResource Manrope}"
                               FontSize="12"
                               Foreground="{DynamicResource ForegrounfBrushes35}"/>
                    <Clock:TimeControl FontFamily="{DynamicResource Manrope}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegrounfBrushes}"
                                       Margin="0,4,0,0"
                                       FullTime="True"/>
                    <TextBlock Text="{Binding SelectionCaption}"
                               Margin="0,4,0,0"
                               FontFamily="{DynamicResource Manrope}"
                               FontSize="14"
                               Foreground="{DynamicResource ForegrounfBrushes85}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="TodayButton"
                        Style="{StaticResource CalendarActionButtonStyle}"
                        VerticalAlignment="Top"
                        Command="{Binding TodayCommand}"
                        Content="Сегодня"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,18,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PreviousMonthButton" Grid.Column="0"
                            ToolTip="Предыдущий месяц"
                            Style="{StaticResource CalendarNavButtonStyle}"
                            Command="{Binding PrevMonthCommand}">
                        <Path Data="M 15 5 L 8 12 L 15 19"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              Width="10"
                              Height="14"/>
                    </Button>

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding MonthYear}"
                               FontFamily="{DynamicResource Manrope}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTitleSolidColorBrush}"/>

                    <Button x:Name="NextMonthButton" Grid.Column="2"
                            ToolTip="Следующий месяц"
                            Style="{StaticResource CalendarNavButtonStyle}"
                            Command="{Binding NextMonthCommand}">
                        <Path Data="M 9 5 L 16 12 L 9 19"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              Width="10"
                              Height="14"/>
                    </Button>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2"
                         Rows="1"
                         Columns="7"
                         Margin="0,0,0,8">
                <TextBlock Text="Пн" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Вт" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Ср" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Чт" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Пт" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Сб" Style="{StaticResource CalendarWeekdayTextStyle}"/>
                <TextBlock Text="Вс" Style="{StaticResource CalendarWeekdayTextStyle}"/>
            </UniformGrid>

            <ItemsControl x:Name="DaysList" Grid.Row="3"
                          ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CalendarDayButtonStyle}"
                                Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{Binding DayNumber}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="NotesPanel" Grid.Row="4" Margin="0,16,0,0" Visibility="Collapsed" TextElement.FontFamily="{DynamicResource Manrope}">
                <Border Height="1" Background="{DynamicResource TopPanelHoverBackgroundBrush}" Margin="0,0,0,12"/>
                <Grid>
                    <TextBlock x:Name="NotesHeading" Text="Заметки дня" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegrounfBrushes}" VerticalAlignment="Center"/>
                    <Button x:Name="AddNoteButton" HorizontalAlignment="Right" Style="{StaticResource CalendarActionButtonStyle}" Content="+ Добавить" Click="AddNote_Click"/>
                </Grid>
                <TextBlock x:Name="NotesStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ForegrounfBrushes85}" FontSize="12"/>
                <Button x:Name="ReloadNotesButton" Content="Повторить загрузку" Margin="0,8,0,0" Visibility="Collapsed" Style="{StaticResource CalendarActionButtonStyle}" Click="ReloadNotes_Click"/>
                <TextBlock x:Name="EmptyNotesText" Text="На этот день заметок нет" Margin="0,14,0,0" Foreground="{DynamicResource ForegrounfBrushes45}" FontSize="13"/>
                <ScrollViewer x:Name="NotesListScroll" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl x:Name="NotesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OpenNote_Click" Tag="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="10" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="NoteSurface" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NoteSurface" Property="Background" Value="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"/></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NoteSurface" Property="BorderBrush" Value="{DynamicResource SettingsInteractiveActiveSolidColorBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Caption}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegrounfBrushes}"/>
                                        <TextBlock Text="{Binding Text}" FontSize="12" MaxHeight="34" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegrounfBrushes85}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="NoteDetails" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource ForegrounfBrushes}"/>
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10">
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ForegrounfBrushes85}"/>
                    </ScrollViewer>
                    <WrapPanel>
                        <Button Content="Редактировать" Style="{StaticResource CalendarActionButtonStyle}" Click="EditNote_Click" Margin="0,0,6,0"/>
                        <Button Content="Удалить" Style="{StaticResource CalendarActionButtonStyle}" Click="DeleteNote_Click" Margin="0,0,6,0"/>
                        <Button Content="×" ToolTip="Закрыть заметку" Style="{StaticResource CalendarNavButtonStyle}" Click="CloseNote_Click"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="NoteEditor" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="EditorHeading" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegrounfBrushes}"/>
                    <TextBlock Text="Дата" Margin="0,10,0,4" FontSize="12" Foreground="{DynamicResource ForegrounfBrushes85}"/>
                    <DatePicker x:Name="NoteDate" FontSize="13" Foreground="{DynamicResource ForegrounfBrushes}" Background="Transparent" BorderThickness="0">
                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource NoteInputStyle}"/>
                        </DatePicker.Resources>
                    </DatePicker>
                    <TextBlock Text="Заголовок (необязательно)" Margin="0,10,0,4" FontSize="12" Foreground="{DynamicResource ForegrounfBrushes85}"/>
                    <TextBox x:Name="NoteTitle" MaxLength="200" Style="{StaticResource NoteInputStyle}"/>
                    <TextBlock Text="Текст заметки" Margin="0,10,0,4" FontSize="12" Foreground="{DynamicResource ForegrounfBrushes85}"/>
                    <TextBox x:Name="NoteText" Height="100" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource NoteInputStyle}"/>
                    <TextBlock x:Name="EditorError" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource ForegrounfBrushes85}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Сохранить" Style="{StaticResource CalendarActionButtonStyle}" Click="SaveNote_Click" Margin="0,0,8,0"/>
                        <Button Content="Отмена" Style="{StaticResource CalendarActionButtonStyle}" Click="CancelEdit_Click"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="DeleteConfirmation" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="Удалить выбранную заметку?" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ForegrounfBrushes}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Удалить" Style="{StaticResource CalendarActionButtonStyle}" Click="ConfirmDelete_Click" Margin="0,0,8,0"/>
                        <Button Content="Отмена" Style="{StaticResource CalendarActionButtonStyle}" Click="CancelDelete_Click"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
