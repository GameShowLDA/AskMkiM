<UserControl x:Class="UI.Controls.Runner.RunControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UI.Controls.Runner"
             mc:Ignorable="d"
             xmlns:Controls="clr-namespace:UI.Controls.TextEditorControl"
             xmlns:Protocol="clr-namespace:Ask.UI.Controls.ProtocolNew;assembly=Ask.UI"
             xmlns:ErrorList="clr-namespace:Ask.UI.Controls.ErrorList;assembly=Ask.UI"
             xmlns:MultiWindow="clr-namespace:UI.Components"
             xmlns:Icons="clr-namespace:UI.Icon"
             xmlns:fileEnums="clr-namespace:Ask.Core.Shared.Metadata.Enums.FileEnums;assembly=Ask.Core"
             xmlns:docking="clr-namespace:UI.Windows.WpfDocking.Windows.Docking"
             xmlns:primitives="clr-namespace:UI.Windows.WpfDocking.Windows.Docking.Primitives"
             xmlns:SharedIcons="clr-namespace:Ask.UI.Shared.Components.Icons;assembly=Ask.UI"
             xmlns:workspace="clr-namespace:Ask.UI.ThirdParty.Docking.Integration.ExecutionWorkspace;assembly=Ask.UI"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="RunnerTranslationStyle" TargetType="{x:Type docking:DockItem}"
               BasedOn="{StaticResource {x:Type docking:DockItem}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type docking:DockItem}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RunnerSourceStyle" TargetType="{x:Type docking:DockItem}"
               BasedOn="{StaticResource {x:Type docking:DockItem}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type docking:DockItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Height="40" Margin="5" Padding="6,4"
                                    Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"
                                    Style="{DynamicResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            Click="OpenActiveDocumentButton_Click"
                                            ToolTip="Открыть файл в редакторе"
                                            Style="{StaticResource ActionButtonStyle}">
                                        <SharedIcons:EyeOpenedIcon Size="16"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    </Button>
                                    <Button Grid.Column="1" Margin="8,0,0,0"
                                            Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            Click="OpenActiveDocumentFolderButton_Click"
                                            ToolTip="Показать файл в папке"
                                            Style="{StaticResource ActionButtonStyle}">
                                        <SharedIcons:FolderOpenIcon Size="16"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    </Button>
                                    <Button Grid.Column="2" Margin="8,0,0,0"
                                            Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            Click="PrintActiveDocumentButton_Click"
                                            ToolTip="Печать файла"
                                            Style="{StaticResource ActionButtonStyle}">
                                        <SharedIcons:PrintIcon Size="16"
                                            IsPrinting="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    </Button>
                                    <Button x:Name="SaveSourceButton" Grid.Column="3" Margin="8,0,0,0"
                                            Click="SaveSourceButton_Click"
                                            ToolTip="Сохранить файл" Style="{StaticResource SaveButtonStyle}">
                                        <SharedIcons:SaveIcon Size="16"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    </Button>
                                    <Button x:Name="TranslateSourceButton" Grid.Column="4" Margin="8,0,0,0"
                                            IsEnabled="{TemplateBinding Tag}"
                                            Click="TranslateSourceButton_Click" ToolTip="Транслировать текущий текст"
                                            Style="{StaticResource SaveButtonStyle}">
                                        <SharedIcons:ExecutionPlayCircleIcon Size="16"
                                            IsHovering="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    </Button>
                                    <TextBlock Grid.Column="5" Margin="12,0" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource WinstonBold}" FontSize="16"
                                               Foreground="{DynamicResource ForegrounfBrushes}"
                                               TextTrimming="CharacterEllipsis" Text="{TemplateBinding TabText}" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RunnerDocumentStyle" TargetType="{x:Type docking:DockItem}"
               BasedOn="{StaticResource {x:Type docking:DockItem}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type docking:DockItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="DocumentActionPanel" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    Grid.Row="0"
                                    Height="40"
                                    MaxHeight="40"
                                    Margin="5"
                                    Padding="6,4"
                                    Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"
                                    Style="{DynamicResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="OpenActiveDocumentButton_Click"
                                            ToolTip="Открыть файл в редакторе"
                                            Style="{StaticResource ActionButtonStyle}">
                                        <SharedIcons:EyeOpenedIcon Size="16"
                                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="OpenActiveDocumentFolderButton_Click"
                                            ToolTip="Показать файл в папке"
                                            Style="{StaticResource ActionButtonStyle}">
                                        <SharedIcons:FolderOpenIcon Size="16"
                                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>

                                    <Button x:Name="ExportPdfButton" Grid.Column="2" Visibility="Collapsed"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="ExportActiveDocumentPdfButton_Click"
                                            ToolTip="Экспортировать протокол в PDF"
                                            Style="{StaticResource ActionButtonStyle}">
                                        <SharedIcons:ExportConfigIcon Size="16"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>

                                    <Button Grid.Column="3"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="PrintActiveDocumentButton_Click"
                                            ToolTip="Печать файла"
                                            Style="{StaticResource ActionButtonStyle}">
                                        <SharedIcons:PrintIcon Size="16"
                                                               IsPrinting="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>

                                    <TextBlock x:Name="ActiveDocumentFileName"
                                               Grid.Column="4"
                                               Margin="12,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource WinstonBold}"
                                               FontSize="16"
                                               Foreground="{DynamicResource ForegrounfBrushes}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Text="{Binding TabText}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Static fileEnums:FileType.InspectionProtocol}">
                                <Setter TargetName="ExportPdfButton" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <workspace:ExecutionWorkspaceControl x:Name="RunnerWorkspace" />
</UserControl>
