<UserControl x:Class="UI.Controls.Runner.RunControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UI.Controls.Runner"
             mc:Ignorable="d" 
             xmlns:Controls="clr-namespace:UI.Controls.TextEditorControl"
             xmlns:Protocol="clr-namespace:Ask.UI.Controls.ProtocolNew;assembly=Ask.UI"
             xmlns:ErrorList="clr-namespace:Ask.UI.Controls.ErrorList;assembly=Ask.UI"
             xmlns:MultiWindow="clr-namespace:UI.Components"
             xmlns:Icons="clr-namespace:UI.Icon"
             xmlns:SharedIcons="clr-namespace:Ask.UI.Shared.Components.Icons;assembly=Ask.UI"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="BottomRow" Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid x:Name="RightBox" Grid.Column="0" >
                    <ContentControl  x:Name="MainContent"/>
                </Grid>
            </Grid>

            <GridSplitter  Grid.Row="1" 
              Height="5"
              Background="Transparent"
              BorderThickness="0,2,0,0"
              BorderBrush="{DynamicResource VioletColorSolidColorBrush}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ResizeDirection="Rows"
              DragStarted="BottomSplitter_OnDragStarted"
              DragDelta="BottomSplitter_OnDragDelta"
              DragCompleted="BottomSplitter_OnDragCompleted" Cursor="SizeNS"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <ErrorList:ErrorListControl  
                x:Name="ErrorListBoxVertical" 
                MinHeight="60"
                StringsNumberVisible="Visible" 
                MeasureResultVisible="Visible" 
                Grid.ColumnSpan="3"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1"
        Background="Transparent"
        BorderThickness="2,0,0,0"
        BorderBrush="{DynamicResource VioletColorSolidColorBrush}"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="DocumentActionPanel"
                    Grid.Row="0"
                    Height="40"
                    MaxHeight="40"
                    Margin="5"
                    Padding="6,4"
                    Visibility="Collapsed"
                    Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"
                    Style="{DynamicResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            VerticalAlignment="Center"
                            Click="OpenActiveDocumentButton_Click"
                            ToolTip="Открыть файл в редакторе"
                            Style="{StaticResource ActionButtonStyle}">
                        <SharedIcons:EyeOpenedIcon Size="16"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    </Button>

                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="OpenActiveDocumentFolderButton_Click"
                            ToolTip="Показать файл в папке"
                            Style="{StaticResource ActionButtonStyle}">
                        <SharedIcons:FolderOpenIcon Size="16"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    </Button>

                    <Button Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="PrintActiveDocumentButton_Click"
                            ToolTip="Печать файла"
                            Style="{StaticResource ActionButtonStyle}">
                        <SharedIcons:PrintIcon Size="16"
                                               IsPrinting="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    </Button>

                    <TextBlock x:Name="ActiveDocumentFileName"
                               Grid.Column="3"
                               Margin="12,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource WinstonBold}"
                               FontSize="16"
                               Foreground="{DynamicResource ForegrounfBrushes}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="TranstatedFile">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>


                <Grid x:Name="LeftBox" Grid.Row="1">
                    <Controls:TextEditorContainer x:Name="ChildTextEditorContainer"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</UserControl>

