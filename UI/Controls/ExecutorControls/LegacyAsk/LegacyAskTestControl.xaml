<UserControl x:Class="UI.Controls.ExecutorControls.LegacyAsk.LegacyAskTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Protocol="clr-namespace:Ask.UI.Controls.ProtocolNew;assembly=Ask.UI"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="900">

    <Protocol:ProtocolUI x:Name="ProtocolUI" Header="Тесты АСК" Tag="legacyAskTestsHelp">
        <Protocol:ProtocolUI.ContentView>
            <Border Padding="14"
                    Background="{DynamicResource SettingsBackgroundSolidColorBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Стойка АСК"
                                   Foreground="{DynamicResource SettingsTitleSolidColorBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,6"/>

                        <ComboBox Height="42"
                                  ItemsSource="{Binding ChassisItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding SelectedChassis, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Style="{DynamicResource CustomComboBoxStyle}"
                                  Margin="0,0,0,14"/>

                        <TextBlock Text="Тест"
                                   Foreground="{DynamicResource SettingsTitleSolidColorBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,6"/>

                        <ComboBox Height="42"
                                  ItemsSource="{Binding TestItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding SelectedTest, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  Style="{DynamicResource CustomComboBoxStyle}"
                                  Margin="0,0,0,12"/>

                        <Border Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTest.Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Foreground="{DynamicResource SettingsTitleSolidColorBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding SelectedTest.Code, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Foreground="{DynamicResource SettingsTitleSolidColorBrush}"
                                           Opacity="0.65"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding ParameterItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                            BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="0"
                                            Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="40"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Label}"
                                                       Foreground="{DynamicResource SettingsTitleSolidColorBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Padding="8,8,8,6"/>

                                            <TextBox Grid.Row="1"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Height" Value="40"/>
                                                        <Setter Property="FontSize" Value="16"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Background" Value="#718092"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SettingsTitleSolidColorBrush}"/>
                                                        <Setter Property="Padding" Value="8,0"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EditorKind}" Value="Text">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>

                                            <ComboBox Grid.Row="1"
                                                      ItemsSource="{Binding Options}"
                                                      SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="40">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource CustomComboBoxStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EditorKind}" Value="Choice">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>

                                            <CheckBox Grid.Row="1"
                                                      IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="{Binding Value}"
                                                      VerticalAlignment="Center"
                                                      Margin="12,0">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsCheckBox}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EditorKind}" Value="Bool">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Hint}"
                                                       Foreground="{DynamicResource SettingsTitleSolidColorBrush}"
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Margin="8,6,8,8"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                BorderBrush="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,2,0,0">
                            <TextBlock Text="{Binding SelectedInstruction, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="{DynamicResource SettingsTitleSolidColorBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Protocol:ProtocolUI.ContentView>
    </Protocol:ProtocolUI>
</UserControl>
