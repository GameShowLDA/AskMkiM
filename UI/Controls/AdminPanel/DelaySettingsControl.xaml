<UserControl x:Class="UI.Controls.AdminPanel.DelaySettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Icons="clr-namespace:UI.Icon"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="800">
    <Border Margin="15,10"
            Style="{DynamicResource SettingPanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Padding="10"
                           Text="Задержки оборудования"
                           Style="{DynamicResource SettingsTitleStyle}"/>

                <StackPanel Grid.Column="1"
                            Margin="20,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Icons:SuccessIconControlV2 x:Name="SaveIcon"
                                                Width="30"
                                                Height="30"
                                                Margin="0,0,10,0"
                                                CheckThickness="4"
                                                ToolTip="Сохранить"
                                                Visibility="Collapsed"
                                                CircleBackground="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                                CircleBorder="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                                PreviewMouseDown="SaveIcon_PreviewMouseDown"/>
                    <Icons:ErrorIconControlV2 x:Name="CancelIcon"
                                              Width="30"
                                              Height="30"
                                              CrossThickness="4"
                                              ToolTip="Отменить изменения"
                                              Visibility="Collapsed"
                                              CircleBackground="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                                              CircleBorder="{DynamicResource SettingsInteractiveBorderSolidColorBrush}"
                                              PreviewMouseDown="CancelIcon_PreviewMouseDown"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,0,10,10">
                    <TextBlock Margin="5,0,5,12"
                               Text="Значения задаются в миллисекундах. Нулевая задержка отключает ожидание и вывод сообщения."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundSolidColorBrush}"/>

                    <Border Padding="16"
                            Style="{DynamicResource SettingCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Margin="0,6,20,12"
                                       Text="ППУ — после испытания напряжения"
                                       Style="{DynamicResource SettingsHeaderStyle}"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     x:Name="BreakdownPostTestDelayTextBox"
                                     Margin="0,0,8,8"
                                     Style="{DynamicResource BorderedTextBox}"
                                     HorizontalContentAlignment="Right"
                                     PreviewTextInput="DelayTextBox_PreviewTextInput"
                                     TextChanged="DelayTextBox_TextChanged"
                                     DataObject.Pasting="DelayTextBox_Pasting"/>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Margin="0,6,0,12"
                                       Text="мс"
                                       Foreground="{DynamicResource ForegroundSolidColorBrush}"/>

                            <TextBlock Grid.Row="1"
                                       Margin="0,6,20,12"
                                       Text="МКР — перед отправкой команды"
                                       Style="{DynamicResource SettingsHeaderStyle}"/>
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     x:Name="ModulePreCommandDelayTextBox"
                                     Margin="0,0,8,8"
                                     Style="{DynamicResource BorderedTextBox}"
                                     HorizontalContentAlignment="Right"
                                     PreviewTextInput="DelayTextBox_PreviewTextInput"
                                     TextChanged="DelayTextBox_TextChanged"
                                     DataObject.Pasting="DelayTextBox_Pasting"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Margin="0,6,0,12"
                                       Text="мс"
                                       Foreground="{DynamicResource ForegroundSolidColorBrush}"/>

                            <TextBlock Grid.Row="2"
                                       Margin="0,6,20,0"
                                       Text="МКР — после отправки команды"
                                       Style="{DynamicResource SettingsHeaderStyle}"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     x:Name="ModulePostCommandDelayTextBox"
                                     Margin="0,0,8,0"
                                     Style="{DynamicResource BorderedTextBox}"
                                     HorizontalContentAlignment="Right"
                                     PreviewTextInput="DelayTextBox_PreviewTextInput"
                                     TextChanged="DelayTextBox_TextChanged"
                                     DataObject.Pasting="DelayTextBox_Pasting"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Margin="0,6,0,0"
                                       Text="мс"
                                       Foreground="{DynamicResource ForegroundSolidColorBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
