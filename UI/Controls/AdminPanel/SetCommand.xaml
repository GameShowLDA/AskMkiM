<UserControl x:Class="UI.Controls.AdminPanel.SetCommand"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="920">
    <Grid>
        <Border Background="{DynamicResource SetCommandConsoleBackgroundBrush}"
                BorderBrush="{DynamicResource SetCommandConsoleBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource SetCommandConsoleHeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource SetCommandConsoleBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="Командная консоль"
                                       Foreground="{DynamicResource SetCommandConsoleTitleBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="#28C840"/>
                            <TextBlock Text="Готово к работе"
                                       Foreground="{DynamicResource SetCommandConsoleSecondaryTextBrush}"
                                       FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyConsoleHint"
                               Margin="26,22"
                               Text="История команд появится здесь"
                               Foreground="{DynamicResource SetCommandConsoleMutedTextBrush}"
                               FontFamily="Consolas"
                               FontSize="16"
                               IsHitTestVisible="False"
                               VerticalAlignment="Top"/>
                    <ScrollViewer x:Name="ConsoleScroll"
                                  Padding="24,20"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="ConsolePanel"
                                    HorizontalAlignment="Stretch"/>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2"
                        Margin="18"
                        Padding="6"
                        Background="{DynamicResource SetCommandConsoleInputBackgroundBrush}"
                        BorderBrush="{DynamicResource SetCommandConsoleInputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Margin="12,0,10,0"
                                   Text="›"
                                   Foreground="{DynamicResource SetCommandConsolePromptBrush}"
                                   FontFamily="Consolas"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="CommandInput"
                                 Grid.Column="1"
                                 MinHeight="44"
                                 Padding="4,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource SetCommandConsoleInputTextBrush}"
                                 Foreground="{DynamicResource SetCommandConsoleInputTextBrush}"
                                 FontFamily="Consolas"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 PreviewKeyDown="CommandInput_KeyDown"/>

                        <Border Grid.Column="2"
                                Margin="8,0,3,0"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SetCommandConsoleKeyBackgroundBrush}"
                                CornerRadius="7">
                            <TextBlock Text="ENTER"
                                       Foreground="{DynamicResource SetCommandConsoleSecondaryTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <ListBox x:Name="AutocompleteBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="2"
                                 MaxHeight="180"
                                 Margin="0,6,0,0"
                                 Padding="4"
                                 Background="{DynamicResource SetCommandConsoleAutocompleteBackgroundBrush}"
                                 BorderBrush="{DynamicResource SetCommandConsoleInputBorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{DynamicResource SetCommandConsoleInputTextBrush}"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
