<UserControl x:Class="UI.Controls.AdminPanel.AdminPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <Style x:Key="MacNavigationItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes85}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavigationSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Ellipse x:Name="ActiveDot"
                                         Grid.Column="1"
                                         Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"
                                         Fill="Transparent"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationSurface"
                                        Property="Background"
                                        Value="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegrounfBrushes}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavigationSurface"
                                        Property="Background"
                                        Value="{DynamicResource SettingsInteractiveActiveSolidColorBrush}"/>
                                <Setter TargetName="ActiveDot"
                                        Property="Fill"
                                        Value="White"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SettingsMainBackgroundSolidColorBrush}">
        <Border Margin="18"
                Background="{DynamicResource SettingCardBackground}"
                BorderBrush="{DynamicResource SettingCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                        BorderBrush="{DynamicResource SettingCardBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1"
                                   Text="Сервисная консоль"
                                   Foreground="{DynamicResource ForegrounfBrushes85}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>

                        <Border Grid.Column="2"
                                Padding="12,6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SettingCardBackground}"
                                CornerRadius="8">
                            <TextBlock Text="Администратор"
                                       Foreground="{DynamicResource ForegrounfBrushes85}"
                                       FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Padding="24"
                            Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                            BorderBrush="{DynamicResource SettingCardBorderBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="2,4,2,32">
                                <TextBlock Text="Панель администратора"
                                           Foreground="{DynamicResource ForegrounfBrushes}"
                                           FontFamily="{DynamicResource WinstonMedium}"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Margin="0,9,0,0"
                                           Text="Диагностика, обслуживание и прямое управление оборудованием"
                                           Foreground="{DynamicResource ForegrounfBrushes85}"
                                           FontSize="15"
                                           LineHeight="22"
                                           TextWrapping="Wrap"
                                           Opacity="0.72"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1"
                                       Margin="6,0,0,13"
                                       Text="ИНСТРУМЕНТЫ"
                                       Foreground="{DynamicResource ForegrounfBrushes85}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.55"/>

                            <StackPanel Grid.Row="2">
                                <RadioButton x:Name="ServiceUtilitiesNavigation"
                                             GroupName="AdminNavigation"
                                             Content="Сервисные утилиты"
                                             Style="{StaticResource MacNavigationItemStyle}"
                                             Checked="ServiceUtilitiesNavigation_Checked"/>
                                <RadioButton GroupName="AdminNavigation"
                                             Content="База данных"
                                             Style="{StaticResource MacNavigationItemStyle}"
                                             Checked="DatabaseNavigation_Checked"/>
                                <RadioButton GroupName="AdminNavigation"
                                             Content="Сопротивление МКР"
                                             Style="{StaticResource MacNavigationItemStyle}"
                                             Checked="ResistanceNavigation_Checked"/>
                            </StackPanel>

                            <Border Grid.Row="3"
                                    Padding="14,12"
                                    Background="{DynamicResource SettingCardBackground}"
                                    BorderBrush="{DynamicResource SettingCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9"
                                             Height="9"
                                             Margin="0,0,10,0"
                                             Fill="#28C840"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Режим администратора активен"
                                               Foreground="{DynamicResource ForegrounfBrushes85}"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <ContentControl x:Name="RightContentPresenter"
                                    Grid.Column="1"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
