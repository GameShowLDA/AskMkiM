<Window x:Class="UI.Controls.Search.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Elements="clr-namespace:UI.Components.SearchControls"
        xmlns:askUiIcons="clr-namespace:Ask.UI.Shared.Components.Icons;assembly=Ask.UI" 
        Title="SearchWindow" Height="90" Width="410"
        MinWidth="410"
        MaxWidth="410"
        WindowStyle="None"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        AllowsTransparency="True"
        SizeChanged="Window_SizeChanged"
        ShowInTaskbar="False"
        Background="Transparent"
        >
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SearchWindow.Styles.xaml"/></ResourceDictionary.MergedDictionaries>
        <!-- Анимация появления сверху -->
        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation
                Storyboard.TargetName="WindowContainer"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                From="-18" To="0" Duration="0:0:0.28" DecelerationRatio="0.9">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="WindowContainer"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                From="0.985" To="1" Duration="0:0:0.28" DecelerationRatio="0.9">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="WindowContainer"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                From="0.985" To="1" Duration="0:0:0.28" DecelerationRatio="0.9">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="WindowContainer"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.24" DecelerationRatio="0.9"/>
        </Storyboard>

        <Storyboard x:Key="HideAnimation">
            <DoubleAnimation
                Storyboard.TargetName="WindowContainer"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                From="0" To="-18" Duration="0:0:0.2" AccelerationRatio="0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="WindowContainer"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                From="1" To="0.985" Duration="0:0:0.2" AccelerationRatio="0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="WindowContainer"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                From="1" To="0.985" Duration="0:0:0.2" AccelerationRatio="0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="WindowContainer"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0" Duration="0:0:0.18" AccelerationRatio="0.8"/>
        </Storyboard>

        <!-- Анимации раскрытия строки замены -->
        <Storyboard x:Key="ExpandReplaceRowAnimation">
            <DoubleAnimation
                Storyboard.TargetName="ReplaceRowPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.30" DecelerationRatio="0.9">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="ReplaceRowPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="-10" To="0" Duration="0:0:0.30" DecelerationRatio="0.9">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="OptionsShiftDownAnimation">
            <DoubleAnimation
                Storyboard.TargetName="OptionsRowPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="-8" To="0" Duration="0:0:0.28" DecelerationRatio="0.9"
                FillBehavior="Stop" BeginTime="0:0:0.04">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="CollapseReplaceRowAnimation">
            <DoubleAnimation
                Storyboard.TargetName="ReplaceRowPanel"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0" Duration="0:0:0.22" AccelerationRatio="0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="ReplaceRowPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="0" To="-10" Duration="0:0:0.22" AccelerationRatio="0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="OptionsShiftUpAnimation">
            <DoubleAnimation
                Storyboard.TargetName="OptionsRowPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="0" To="-8" Duration="0:0:0.20" AccelerationRatio="0.75"
                FillBehavior="Stop" BeginTime="0:0:0.02">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </ResourceDictionary></Window.Resources>

    <Grid x:Name="WindowContainer" RenderTransformOrigin="0.5,0.0" Margin="12,0,12,12">
        <Grid.Effect>
            <!-- Тень в стиле Spotlight: ярче, смещена вниз, без подсветки верхней грани -->
            <DropShadowEffect Color="#88000000"
                              BlurRadius="24"
                              ShadowDepth="12"
                              Opacity="0.32"
                              Direction="270"
                              RenderingBias="Quality"/>
        </Grid.Effect>
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
                <TranslateTransform Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Border  Background="{DynamicResource SettingCardBackground}"
                BorderBrush="{DynamicResource ModernDataGridBorderBrush}"
                BorderThickness="1"
                CornerRadius="0,0,9,9">

        <Grid x:Name="MainGrid">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="87"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="ReplaceRow" Height="0"/>
                <!-- Скрытая строка по умолчанию -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Строка 1 -->
            <Elements:ArrowButton x:Name="ToggleArrow"
                      Width="25" Height="25" 
                      VerticalAlignment="Center" 
                      HorizontalAlignment="Center"  
                      ArrowColor="{StaticResource ForegroundSolidColorBrush}" 
                      HoverArrowColor="{StaticResource ActiveBorderSolidColorBrush}" 
                      IsArrowUp="False"
                      Cursor="Hand"
                      ToolTip="Показать/скрыть строку замены (Ctrl+H)"
                      PreviewMouseDown="ToggleArrow_PreviewMouseDown"/>

            <TextBox
             Style="{StaticResource SearchInputStyle}" x:Name="SearchTextBox"  Grid.Column="1" Grid.Row="0" Margin="2 3" Tag="Найти..." BorderThickness="0"
             VerticalContentAlignment="Center"
             HorizontalContentAlignment="Left"
             Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
             BorderBrush="{DynamicResource ModernDataGridBorderBrush}"
             Foreground="{DynamicResource ForegrounfBrushes}"
             FontSize="14"
             CaretBrush="{DynamicResource ForegrounfBrushes}"


         />

            <Button
                Style="{StaticResource WindowsButtonStyle}"
                x:Name="exitButton"
                Grid.Column="2"
                Width="30"
                Height="30"
                HorizontalAlignment="Right"
                Cursor="Hand"
                ToolTip="Закрыть окно поиска (Esc / Ctrl+F)"
                PreviewMouseDown="exitButton_PreviewMouseDown">
                <askUiIcons:WindowCloseIcon Size="14"
                    IsHovering="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
            </Button>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>

                <Elements:SearchArrows x:Name="searchArrows" Grid.Column="0" Margin="3 0 0 0" Cursor="Hand"/>

            </Grid>

            <TextBlock x:Name="SearchStatus" Grid.Row="2" Grid.Column="2" Visibility="Visible"
                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource ForegrounfBrushes}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

            <!-- Строка 2 (По умолчанию скрыта) -->
            <Grid x:Name="ReplaceRowPanel"
                  Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Opacity="0"
                  Visibility="Collapsed"
                  RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <TranslateTransform Y="-12"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="87"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    Style="{StaticResource SearchInputStyle}" x:Name="ReplaceTextBox"  Grid.Column="1" Margin="2 3" Tag="Заменить..." BorderThickness="0"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Left"
                    Background="{DynamicResource SettingsInteractiveBackgroundSolidColorBrush}"
                    BorderBrush="{DynamicResource ModernDataGridBorderBrush}"
                    Foreground="{DynamicResource ForegrounfBrushes}"
                    FontSize="14"
                    CaretBrush="{DynamicResource ForegrounfBrushes}"

                    />



                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Elements:ReplaseWordButton Height="25" Width="25" Cursor="Hand" ToolTip="Заменить текущее совпадение (Alt+R)"/>
                    <Elements:ReplaseAllWordsButton Height="25" Width="25" Grid.Column="1" Cursor="Hand" ToolTip="Заменить все совпадения (Alt+A)"/>
                </Grid>
            </Grid>
                <Elements:SearchSliderHandle x:Name="SearchSlider" Grid.Row="2" Grid.Column="0" Margin="4 10 2 2"
                                             PreviewMouseLeftButtonDown="SearchSlider_MouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="SearchSlider_MouseLeftButtonUp"
                                             MouseMove="SearchSlider_MouseMove"
                                             ToolTip="Передвинуть окно поиска"/>

                <!-- Строка 3 -->
            <Grid x:Name="OptionsRowPanel" Grid.Row="2" Grid.Column="1" RenderTransformOrigin="0.5,0" MinHeight="40">
                <Grid.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12*"/>
                    <ColumnDefinition Width="12*"/>
                    <ColumnDefinition Width="52*"/>
                </Grid.ColumnDefinitions>
                    <Elements:CaseToggleButton x:Name="caseButton" Grid.Row="2" Grid.Column="0" 
                           Width="25" Height="25"
                           Foreground="Black"
                           Cursor="Hand"
                           ToolTip="Учитывать регистр при поиске"
                           />
                <Elements:WholeWordToggleButton x:Name="wholeWordButton" Height="25" Width="25" Grid.Column="1" Cursor="Hand" ToolTip="Искать только целые слова"/>

                <ComboBox Style="{StaticResource SearchScopeComboStyle}" x:Name="searchAreaParameters" Grid.Column="2" Margin="2" VerticalAlignment="Stretch" SelectedIndex="0"
                SelectionChanged="PART_EditableTextBox_SelectionChanged">

                    <ComboBoxItem Content="Текущий документ" Tag="FindInThisFile"/>
                    <ComboBoxItem Content="Все открытые документы" Tag="FindInOpenedFiles" />
                    <ComboBoxItem Content="Найти в файле" Tag="FindInFile" />


                </ComboBox>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
