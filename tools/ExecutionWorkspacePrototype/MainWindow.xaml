<Window x:Class="ExecutionWorkspacePrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workspace="clr-namespace:Ask.UI.ThirdParty.Docking.Integration.ExecutionWorkspace;assembly=Ask.UI"
        Title="ExecutionWorkspace — AvalonDock prototype"
        Width="1500" Height="900" MinWidth="900" MinHeight="600"
        Background="{DynamicResource SettingsNestedGroupBackgroundSolidColorBrush}"
        Foreground="{DynamicResource ForegrounfBrushes}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="10,8" Background="#202936" BorderBrush="#3C4858" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Margin="0,0,8,0" Padding="12,6" Content="Тёмная" Click="DarkThemeClick" />
                <Button Margin="0,0,8,0" Padding="12,6" Content="Светлая" Click="LightThemeClick" />
                <Button Margin="0,0,8,0" Padding="12,6" Content="Сохранить раскладку" Click="SaveLayoutClick" />
                <Button Margin="0,0,8,0" Padding="12,6" Content="Восстановить" Click="RestoreLayoutClick" />
                <Button Padding="12,6" Content="Сбросить" Click="ResetLayoutClick" />
            </StackPanel>
        </Border>
        <workspace:ExecutionWorkspaceControl x:Name="Workspace" Grid.Row="1" />
    </Grid>
</Window>
