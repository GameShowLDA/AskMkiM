<Window x:Class="Ask.Support.HelpBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Справочная система" Width="1440" Height="900" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource HelpBackground}" Foreground="{DynamicResource HelpForeground}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Styles/WindowActionButtons.xaml"/>
            <ResourceDictionary Source="Styles/WindowActionIcons.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="HelpBackground" Color="#151E28"/>
        <SolidColorBrush x:Key="HelpForeground" Color="#E8EEF7"/>
        <SolidColorBrush x:Key="HelpBorder" Color="#324255"/>
        <SolidColorBrush x:Key="HelpHover" Color="#243241"/>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource WindowActionButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{DynamicResource HelpBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource HelpForeground}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HelpHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
          </ResourceDictionary>
    </Window.Resources>
    <!-- Дочернее HWND WebView2 не должно перекрывать зону WindowChrome для изменения размера. -->
    <Border BorderBrush="{DynamicResource HelpBorder}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Background="{DynamicResource HelpBackground}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Свернуть"
                            AutomationProperties.Name="Свернуть">
                        <Viewbox Width="14" Height="14"><Path Width="24" Height="24" Data="{StaticResource SemiIconMinus}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                            ToolTip="Развернуть" AutomationProperties.Name="Развернуть">
                        <Viewbox Width="14" Height="14"><Path x:Name="MaximizeIcon" Width="24" Height="24" Data="{StaticResource SemiIconMaximize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
                        <Viewbox Width="14" Height="14"><Path Width="24" Height="24" Data="{StaticResource SemiIconClose}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
            <wv:WebView2 x:Name="Browser" Grid.Row="1"/>
            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Загрузка справки…" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"/>
        </Grid>
    </Border>
</Window>
